@inject ApiClient Api
@inject I18nService L
@inject ISnackbar Snackbar
@inject UiState State

@* ВЫБОР ФАЙЛА НА ДИСКЕ ЭТОГО КОМПЬЮТЕРА (T-12-S1) — «диалог открыть файл от корня файловой
   системы» из задания: кадр датасета LoRA берут откуда угодно, а не только из папки проекта.

   Отличий от двух уже имеющихся выборов ровно два, и оба существенны:
   • FolderPickerDialog ходит по тем же каталогам, но показывает ОДНИ КАТАЛОГИ (он выбирает
     папку проекта) — файла в нём не выбрать;
   • ProjectFilePickerDialog показывает файлы, но не поднимается выше папки проекта.
   Здесь обход начинается со списка дисков (на Linux — с «/») и показывает и то и другое.

   Путь возвращается АБСОЛЮТНЫЙ: это исходник, из которого сервер сделает кадр, а не место
   хранения — храниться кадр всё равно будет в папке проекта.

   ОТКУДА НАЧИНАЕТСЯ ОБХОД (T-273). От корня файловой системы — только когда идти больше
   неоткуда. Порядок такой: каталог, заданный вызывающим (в поле пути уже что-то набрано)
   → каталог ПРОШЛОГО выбора (UiState.LastLocalDir) → запасной каталог вызывающего (папка
   проекта) → список дисков. Кадры датасета кладут пачкой из одной папки, и обход дисков
   заново на каждый кадр — это работа, которую человек делает руками вместо программы. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                               data-localfile-up="1" title="@L["objects.files.up"]"
                               Disabled="@(_list is null || _list.Path.Length == 0)" OnClick="UpAsync" />
                <MudTextField T="string" @bind-Value="_pathInput" Immediate="true"
                              data-localfile-path="1" OnKeyDown="OnPathKeyDown"
                              Margin="Margin.Dense" Class="flex-grow-1" />
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                               data-localfile-refresh="1" OnClick="@(() => LoadAsync(_pathInput))" />
            </MudStack>
            <MudPaper Outlined="true" Elevation="0" Style="height: 360px; overflow-y: auto;"
                      data-localfile-list="1">
                @if (_list is null)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var dir in _list.Dirs)
                        {
                            <MudListItem T="string" data-localfile-dir="@dir.Path"
                                         OnClick="@(() => LoadAsync(dir.Path))">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-2" />
                                @dir.Name
                            </MudListItem>
                        }
                        @* картинки видно сразу: кадр опознают глазами, а не по имени файла *@
                        @foreach (var file in _list.Files.Where(f => !ImagesOnly || f.IsImage))
                        {
                            <MudListItem T="string" data-localfile-file="@file.Path"
                                         OnClick="@(() => Pick(file.Path))">
                                @if (file.IsImage)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Class="mr-2" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Class="mr-2" />
                                }
                                @file.Name
                                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">
                                    @Units.Bytes(file.Size)
                                </MudText>
                            </MudListItem>
                        }
                        @if (_list.Dirs.Count == 0 && _list.Files.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pa-2" data-localfile-empty="1">
                                @L["objects.files.empty"]
                            </MudText>
                        }
                    </MudList>
                    @if (_list.Truncated)
                    {
                        <MudText Typo="Typo.caption" Class="pa-2 mud-text-secondary"
                                 data-localfile-truncated="1">@L["objects.files.truncated"]</MudText>
                    }
                }
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Начальный каталог, заданный вызывающим (в поле пути уже что-то набрано);
    /// пусто — берётся каталог прошлого выбора, затем <see cref="FallbackPath"/>.</summary>
    [Parameter] public string? StartPath { get; set; }

    /// <summary>Запасной каталог (T-273): откуда начинать, если ни заданного, ни каталога
    /// прошлого выбора нет. Для кадра датасета это папка проекта — в ней и лежат картинки,
    /// из которых собирают датасет.</summary>
    [Parameter] public string? FallbackPath { get; set; }

    /// <summary>Показывать только картинки: кадром датасета может быть только изображение,
    /// и предлагать выбрать .zip значит предлагать ошибку.</summary>
    [Parameter] public bool ImagesOnly { get; set; } = true;

    private DirListDto? _list;
    private string _pathInput = "";

    protected override Task OnInitializedAsync() =>
        LoadAsync(FirstPath(StartPath, State.LastLocalDir, FallbackPath));

    /// <summary>
    /// Каталог, с которого начинается обход (T-273): заданный вызывающим → каталог прошлого
    /// выбора → запасной (папка проекта) → null, то есть список дисков, как было раньше.
    /// Правило вынесено в статический метод намеренно: порядок этих трёх — единственное,
    /// что здесь можно нечаянно переставить, и проверяется он тестом.
    /// </summary>
    public static string? FirstPath(string? start, string? remembered, string? fallback)
    {
        foreach (var candidate in new[] { start, remembered, fallback })
        {
            if (!string.IsNullOrWhiteSpace(candidate))
            {
                return candidate;
            }
        }
        return null;
    }

    /// <summary>Выбранный файл: путь возвращается вызывающему, а его каталог запоминается —
    /// со следующего раза обход начнётся отсюда.</summary>
    private void Pick(string path)
    {
        State.SetLastLocalDir(_list?.Path is { Length: > 0 } dir ? dir : null);
        Dialog.Close(DialogResult.Ok(path));
    }

    private async Task LoadAsync(string? path)
    {
        try
        {
            _list = await Api.GetDirsAsync(string.IsNullOrWhiteSpace(path) ? null : path,
                withFiles: true);
            _pathInput = _list.Path;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Task UpAsync() => LoadAsync(_list?.Parent);

    private Task OnPathKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" ? LoadAsync(_pathInput) : Task.CompletedTask;
}
