@inject UiState State
@inject ApiClient Api
@inject I18nService L
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@implements IDisposable

@* «ДИАГРАММЫ В РАБОТЕ» (T-328-S0) — представление списка задач: диаграммы (TaskDiagramView)
   только тех иерархий, где хоть одна задача «в работе» или «на паузе». Рисуется вся
   иерархия — от корня до листьев, а не одна запущенная ветка.

   Во вкладке «Задачи» проекта (FixedProjectId) — одна диаграмма на все такие корни проекта:
   дорожки исполнителей общие. В общем списке задач появляется ещё одна полоса — ПРОЕКТ:
   слева код и название проекта, повёрнутые на 90° против часовой стрелки, справа диаграмма
   его корней. Исполнитель, работающий в двух проектах, повторяется в каждой полосе — только
   с задачами этого проекта. Меню квадрата — то же меню «…», что у всех списков
   задач (TaskActionsMenu, T-495-S0): действия делает оно само. *@

@if (_groups is null)
{
    <MudProgressLinear Indeterminate="true" Class="ai2p-view-busy" />
}
else if (_groups.Count == 0)
{
    <MudText Typo="Typo.body2" data-diagrams-empty="1">@L["tasks.diagrams.empty"]</MudText>
}
else
{
    <div data-tasks-view="diagrams">
        @foreach (var group in _groups)
        {
            <div @key="group.ProjectId" class="ai2p-diagrams-project" data-diagrams-project="@group.ProjectId"
                 style="display: flex; align-items: stretch; margin-bottom: 12px;
                        border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;">
                @if (FixedProjectId is null)
                {
                    @* поворот на 90° против часовой: текст читается снизу вверх. Середину
                       держит flex внешней полосы, а не text-align повёрнутого блока: тот при
                       перерисовке диаграммы (кнопка прозрачности) уезжал вверх *@
                    <div style="display: flex; align-items: center; justify-content: center;
                                padding: 6px 4px; border-right: 1px solid var(--mud-palette-lines-default);"
                         data-diagrams-project-label="1">
                        <span style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;
                                     font-weight: 600;">
                            @group.Label
                        </span>
                    </div>
                }
                <div style="flex: 1; min-width: 0; padding: 4px;">
                    <TaskDiagramView TaskIds="group.RootIds" Version="@string.Join(",", group.RootIds)" />
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>Вкладка «Задачи» проекта: только его иерархии и без полосы проекта.</summary>
    [Parameter] public string? FixedProjectId { get; set; }

    private sealed record Group(string ProjectId, string Label, List<string> RootIds);

    private List<Group>? _groups;
    private Timer? _timer;

    /// <summary>Новые запуски появляются и без действий человека — список корней перечитывается
    /// сам; сами диаграммы обновляются своим таймером, пока идёт работа.</summary>
    private static readonly TimeSpan Refresh = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await ReloadAsync();
        _timer = new Timer(async _ =>
        {
            await ReloadAsync();
            await InvokeAsync(StateHasChanged);
        }, null, Refresh, Refresh);
    }

    private async void OnStateChanged()
    {
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        try
        {
            var tasks = await Api.GetTasksAsync(projectId: FixedProjectId);
            var byId = tasks.ToDictionary(t => t.Id, StringComparer.Ordinal);
            var roots = new List<TaskItem>();
            var seen = new HashSet<string>(StringComparer.Ordinal);
            foreach (var task in tasks.Where(t => t.Status is TaskStatuses.InProgress or TaskStatuses.Paused))
            {
                // корень цепочки; защита от кольца — не глубже числа задач
                var root = task;
                for (var depth = 0; depth <= byId.Count && root.ParentId is { } parentId
                     && byId.TryGetValue(parentId, out var parent); depth++)
                {
                    root = parent;
                }
                if (seen.Add(root.Id))
                {
                    roots.Add(root);
                }
            }
            _groups = roots
                .GroupBy(r => r.ProjectId ?? "")
                .Select(g => new Group(g.Key, ProjectLabel(g.Key),
                    g.OrderBy(r => r.CreatedAt).Select(r => r.Id).ToList()))
                .OrderBy(g => g.Label, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _groups ??= [];
        }
    }

    private string ProjectLabel(string projectId)
    {
        var project = State.Projects.FirstOrDefault(p => p.Id == projectId);
        return project is null ? L["tasks.diagrams.noProject"] : $"{project.DisplayId} {project.Name}".Trim();
    }

    public void Dispose()
    {
        _timer?.Dispose();
        State.Changed -= OnStateChanged;
    }
}
