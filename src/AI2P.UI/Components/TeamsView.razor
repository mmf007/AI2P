@using AI2P.Core.Connectors
@inject UiState State
@inject ApiClient Api
@inject I18nService L
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@implements IDisposable

@* Список команд (ТЗ гл. 11) + запуск/остановка работы команды и вычисляемые статусы
   работы участников (ТЗ v1.14): ИИ — не подключен / подключается / подключен / ошибка,
   человек — офлайн / онлайн. Два представления (ТЗ v1.17): таблица и иерархия
   (руководители → подчинённые; тимлид помечен звездой). С T-629-S0 оба представления
   строятся по оргединицам (T-628-S0): у каждой записи — меню «…» TeamUnitMenu (с T-637-S0
   в нём все действия записи: запуск/остановка участника, подчинённый, изменить, сменить
   активность, удалить), «+» добавляет единицу через отдельную форму, в иерархии
   перетаскивание меняет вышестоящую единицу. Каждое такое действие — свой вызов API,
   меняющий одну единицу, а не перезапись команды. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5" Class="ai2p-view-title">@L["teams.title"]</MudText>
    <MudSpacer />
    <MudSelect T="string" @bind-Value="_view" Label="@L["common.view"]"
               Dense="true" Margin="Margin.Dense" Style="max-width: 160px;">
        <MudSelectItem T="string" Value="@("table")">@L["tasks.view.table"]</MudSelectItem>
        <MudSelectItem T="string" Value="@("tree")">@L["tasks.view.tree"]</MudSelectItem>
    </MudSelect>
    @* кнопка-иконка с подсказкой (гл. 11, эргономика) *@
    <MudTooltip Text="@L["teams.add"]">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Disabled="@(!State.CanManageProjects)"
                       OnClick="@(() => EditAsync(null))" />
    </MudTooltip>
</MudStack>

@if (State.Teams.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["common.empty"]</MudAlert>
}
else if (_view == "tree")
{
    @* иерархия: у каждой команды своё дерево единиц. Перенос — общий движок
       ai2p.initTreeDnd (мышь и палец, липкая полоса вверху, урок T-176) *@
    <MudStack Spacing="3">
        @foreach (var team in State.Teams)
        {
            var work = _work.GetValueOrDefault(team.Id);
            <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@team.Name</MudText>
                    <MudIcon Icon="@(team.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Color="@(team.IsActive ? Color.Success : Color.Default)" Size="Size.Small" />
                    <MudSpacer />
                    @TeamWorkButton(team, work)
                    @TeamButtons(team)
                </MudStack>
                <div id="@TreeId(team)" data-teams-view="tree" data-team-tree="@team.Id">
                    @if (CanEditTeams)
                    {
                        <div class="ai2p-tree-root ai2p-tree-root-top" data-tree-drop="" data-tree-root="top">
                            <MudIcon Icon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" />
                            <b>@L["teams.tree.dnd.root"]</b>
                            <span class="ai2p-tree-hint">@L["teams.tree.dnd.hint"]</span>
                        </div>
                    }
                    @foreach (var (unit, depth) in TeamUnits.Ordered(team.Units))
                    {
                        var member = MemberOf(team, unit);
                        <div class="ai2p-tree-node" draggable="@(CanEditTeams ? "true" : "false")"
                             data-tree-move="@(CanEditTeams ? "1" : "0")"
                             data-tree-task="@unit.Id" data-tree-drop="@unit.Id"
                             data-team-unit="@unit.Id" data-team-unit-level="@depth"
                             style="@($"padding-left: {8 + depth * 24}px;")">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"
                                      Style="@(unit.IsActive ? "" : "opacity: .5;")">
                                @if (CanEditTeams)
                                {
                                    @* ручка (T-4-S1): за неё строка берётся сразу, без удержания *@
                                    <span class="ai2p-tree-grip" data-tree-grip="1" title="@L["teams.tree.dnd.grip"]">
                                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                    </span>
                                }
                                <MudIcon Icon="@(unit.Kind == TeamUnit.Department ? Icons.Material.Filled.Folder : Icons.Material.Filled.Badge)"
                                         Size="Size.Small" />
                                <MudText Typo="Typo.body2">@UnitName(unit)</MudText>
                                @if (member is not null)
                                {
                                    @MemberChip(team, work, member)
                                    <MudText Typo="Typo.caption">@RoleName(member.RoleId)</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Style="opacity: .6;">@L["teams.vacancy"]</MudText>
                                }
                                <MudSpacer />
                                @UnitMenu(team, work, unit)
                            </MudStack>
                        </div>
                    }
                </div>
            </MudPaper>
        }
    </MudStack>
}
else
{
    @* таблица (T-629-S0): каждый исполнитель (оргединица) — своей строкой; команда —
       строкой-заголовком группы со своими кнопками *@
    <MudSimpleTable Dense="true" Hover="true" data-teams-view="table">
        <thead>
            <tr>
                <th>@L["teams.unitName"]</th>
                <th>@L["teams.unitExecutor"]</th>
                <th>@L["teams.manager"]</th>
                <th>@L["teams.role"]</th>
                <th>@L["teams.memberActive"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var team in State.Teams)
            {
                var work = _work.GetValueOrDefault(team.Id);
                <tr data-team-row="@team.Id" style="background: rgba(127,127,127,.08);">
                    <td colspan="4">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@team.Name</MudText>
                            <MudIcon Icon="@(team.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Color="@(team.IsActive ? Color.Success : Color.Default)" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["teams.agentLanguage"]: @team.AgentLanguage</MudText>
                        </MudStack>
                    </td>
                    <td colspan="2" style="white-space: nowrap; text-align: right;">
                        @TeamWorkButton(team, work)
                        @TeamButtons(team)
                    </td>
                </tr>
                @foreach (var (unit, depth) in TeamUnits.Ordered(team.Units))
                {
                    var member = MemberOf(team, unit);
                    <tr data-team-unit="@unit.Id" style="@(unit.IsActive ? "" : "opacity: .5;")">
                        <td><span style="@($"padding-left: {depth * 16}px;")">@UnitName(unit)</span></td>
                        <td>
                            @if (member is not null)
                            {
                                @MemberChip(team, work, member)
                            }
                            else
                            {
                                <span style="opacity: .6;">@L["teams.vacancy"]</span>
                            }
                        </td>
                        <td>@(member?.ParentExecutorId is { } head ? Nick(head) : "")</td>
                        <td>@RoleName(member?.RoleId)</td>
                        <td>
                            <MudIcon Icon="@(unit.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Color="@(unit.IsActive ? Color.Success : Color.Default)" Size="Size.Small" />
                        </td>
                        <td>@UnitMenu(team, work, unit)</td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private readonly Dictionary<string, TeamWorkStatusDto> _work = [];
    private CancellationTokenSource? _poll;
    private string _view = "table";
    private DotNetObjectReference<TeamsView>? _selfRef;

    /// <summary>Правка состава команды: «+», меню «…» и ручки переноса. Роль — та же, что у
    /// раздела /api/teams (ApiPermissions: администратор проектов); у читателя их нет.</summary>
    private bool CanEditTeams => State.CanManageProjects;

    private static string TreeId(Team team) => "ai2p-team-tree-" + team.Id;

    private string Nick(string executorId) =>
        State.Executors.FirstOrDefault(e => e.Id == executorId)?.Nick ?? executorId;

    private string MemberNick(TeamMember member) => Nick(member.ExecutorId);

    private string RoleName(string? roleId) =>
        roleId is null ? "" : State.Roles.FirstOrDefault(r => r.Id == roleId)?.Name ?? "";

    private string UnitName(TeamUnit unit) =>
        unit.Name.Trim().Length > 0 ? unit.Name.Trim() : L["teams.unitKind." + unit.Kind];

    private static TeamMember? MemberOf(Team team, TeamUnit unit) =>
        unit.ExecutorId is null ? null : team.Members.FirstOrDefault(m => m.ExecutorId == unit.ExecutorId);

    /// <summary>Чип участника со статусом работы, звездой тимлида и кнопками запуска (T-129).</summary>
    private RenderFragment MemberChip(Team team, TeamWorkStatusDto? work, TeamMember member) => __builder =>
    {
        var status = work?.Members.FirstOrDefault(m => m.ExecutorId == member.ExecutorId);
        <div class="d-flex align-center" style="gap: 2px;">
            @if (member.IsLead)
            {
                <MudTooltip Text="@L["teams.lead"]">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
                </MudTooltip>
            }
            @if (status is null)
            {
                <MudChip T="string" Size="Size.Small">@MemberNick(member)</MudChip>
            }
            else
            {
                @* есть ошибка — чип открывает её в окне с копированием (todo37) *@
                <MudTooltip Text="@(HasError(status) ? L["teams.error.show"] : StateText(status))">
                    <MudChip T="string" Size="Size.Small" Color="@StateColor(status.State)"
                             Style="@(StateStyle(status.State) + (HasError(status) ? " cursor: pointer;" : ""))"
                             Icon="@StateIcon(status.State)"
                             OnClick="@(HasError(status) ? EventCallback.Factory.Create<MouseEventArgs>(this, () => ShowErrorAsync(status)) : default)">
                        @MemberNick(member)
                    </MudChip>
                </MudTooltip>
            }
        </div>
    };

    /// <summary>Кнопки «запустить» / «остановить» работу команды (ТЗ v1.14).</summary>
    private RenderFragment TeamWorkButton(Team team, TeamWorkStatusDto? work) => __builder =>
    {
        if (work is { IsRunning: true })
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Stop" Disabled="@(!State.CanEdit)"
                       OnClick="@(() => StopAsync(team.Id))">@L["teams.stop"]</MudButton>
        }
        else
        {
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(!team.IsActive || !State.CanEdit)"
                       OnClick="@(() => StartAsync(team.Id))">@L["teams.start"]</MudButton>
        }
    };

    /// <summary>«+» (единица верхнего уровня) и правка свойств команды.</summary>
    private RenderFragment TeamButtons(Team team) => __builder =>
    {
        if (CanEditTeams)
        {
            <MudTooltip Text="@L["teams.unit.add"]">
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                               data-team-unit-add="@team.Id"
                               OnClick="@(() => EditUnitAsync(team, null, null))" />
            </MudTooltip>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           OnClick="@(() => EditAsync(team))" />
        }
    };

    /// <summary>Меню «…» записи (T-637-S0): запуск/остановка участника, подчинённый, правка,
    /// активность, удаление — состав пунктов решает TeamUnitMenu.</summary>
    private RenderFragment UnitMenu(Team team, TeamWorkStatusDto? work, TeamUnit unit) => __builder =>
    {
        <TeamUnitMenu Team="@team" Unit="@unit"
                      Status="@(unit.ExecutorId is { } e ? work?.Members.FirstOrDefault(m => m.ExecutorId == e) : null)"
                      OnStart="@(id => StartMemberAsync(team.Id, id))"
                      OnStop="@(id => StopMemberAsync(team.Id, id))"
                      OnChanged="@(() => RunUnitAsync(() => Task.CompletedTask, null))" />
    };

    protected override async Task OnInitializedAsync()
    {
        // состав команды, правленный на соседнем сервере, приезжает репликацией мимо UI (T-766-S0)
        await State.RefreshPeopleAsync();
        await RefreshWorkAsync();
        // подключение могло начаться до открытия закладки — опрос нужен сразу (todo37_3)
        if (_work.Values.Any(w => w.Members.Any(m => m.State == ExecutorWorkState.Connecting)))
        {
            StartPolling();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_view != "tree" || !CanEditTeams)
        {
            return;
        }
        _selfRef ??= DotNetObjectReference.Create(this);
        // повторный вызов на живом контейнере ничего не делает (флаг в data-атрибуте)
        foreach (var team in State.Teams)
        {
            await Js.InvokeVoidAsync("ai2p.initTreeDnd", TreeId(team), _selfRef);
        }
    }

    public void Dispose()
    {
        _poll?.Cancel();
        _poll?.Dispose();
        _selfRef?.Dispose();
    }

    /// <summary>
    /// Единицу перетащили на другую (или на полосу «на верхний уровень»): сменить
    /// вышестоящую. Имя метода задано общим движком ai2p.initTreeDnd. Перенос между
    /// командами не делается: у каждой команды свой контейнер, а единица живёт в одной.
    /// </summary>
    [JSInvokable]
    public async Task OnTreeDropAsync(string unitId, string? parentUnitId)
    {
        var team = State.Teams.FirstOrDefault(t => t.Units.Any(u => u.Id == unitId));
        var parent = string.IsNullOrEmpty(parentUnitId) ? null : parentUnitId;
        if (team is null || !CanEditTeams || (parent is not null && team.Units.All(u => u.Id != parent)))
        {
            await InvokeAsync(StateHasChanged);
            return;
        }
        var unit = team.Units.First(u => u.Id == unitId);
        // внутрь своего же поддерева нельзя — отказ сразу, сервер проверяет ещё раз
        if (parent is not null && TeamUnits.IsInside(team.Units, team.Units.First(u => u.Id == parent), unit.Id))
        {
            Snackbar.Add(L["msg.team.12"], Severity.Warning);
            return;
        }
        if (unit.ParentUnitId == parent)
        {
            return;
        }
        await RunUnitAsync(() => Api.MoveTeamUnitAsync(team.Id, unitId, parent), L["teams.tree.dnd.moved"]);
    }

    private async Task EditUnitAsync(Team team, TeamUnit? unit, string? parentUnitId)
    {
        var parameters = new DialogParameters<TeamUnitDialog>
        {
            { d => d.Team, team },
            { d => d.Source, unit },
            { d => d.ParentUnitId, parentUnitId },
        };
        var dialog = await Dialogs.ShowAsync<TeamUnitDialog>(
            unit is null ? L["teams.unit.add"] : L["common.edit"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TeamUnitEditDto dto })
        {
            await RunUnitAsync(() => Api.SaveTeamUnitAsync(team.Id, dto), null);
        }
    }

    /// <summary>Вызов правки единицы: ошибка — словами, после любого исхода список
    /// перечитывается, чтобы на экране было то, что лежит в базе.</summary>
    private async Task RunUnitAsync(Func<Task> call, string? done)
    {
        try
        {
            await call();
            if (done is not null)
            {
                Snackbar.Add(done, Severity.Success);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await State.RefreshReferenceDataAsync();
        await RefreshWorkAsync();
        State.NotifyChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshWorkAsync()
    {
        foreach (var team in State.Teams)
        {
            try
            {
                _work[team.Id] = await Api.GetTeamWorkAsync(team.Id);
            }
            catch (ApiException)
            {
                // команда могла быть удалена между обновлениями — пропускаем
            }
        }
    }

    private async Task StartAsync(string teamId)
    {
        try
        {
            _work[teamId] = await Api.StartTeamWorkAsync(teamId);
            StartPolling();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task StopAsync(string teamId)
    {
        try
        {
            _work[teamId] = await Api.StopTeamWorkAsync(teamId);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Поднять ОДНОГО участника (T-129): участника добавили в уже работающую команду
    /// или он упал по ошибке — остальных это не трогает.</summary>
    private async Task StartMemberAsync(string teamId, string executorId)
    {
        try
        {
            _work[teamId] = await Api.StartTeamMemberAsync(teamId, executorId);
            StartPolling();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Остановить ОДНОГО участника (T-129): работа команды при этом не гасится.</summary>
    private async Task StopMemberAsync(string teamId, string executorId)
    {
        try
        {
            _work[teamId] = await Api.StopTeamMemberAsync(teamId, executorId);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Пока есть участники «в процессе подключения» — периодически обновлять статусы.
    /// Опрос идёт до конца подключения (todo37_3): локальный сервер модели поднимается
    /// минутами, а участник оставался в UI «запускается» навсегда.</summary>
    private void StartPolling()
    {
        _poll?.Cancel();
        _poll = new CancellationTokenSource();
        var ct = _poll.Token;
        _ = InvokeAsync(async () =>
        {
            // 360 попыток по 2 с — 12 минут (ожидание готовности сервера модели — 10 мин)
            for (var i = 0; i < 360 && !ct.IsCancellationRequested; i++)
            {
                await Task.Delay(2000, ct);
                await RefreshWorkAsync();
                StateHasChanged();
                if (!_work.Values.Any(w => w.Members.Any(m => m.State == ExecutorWorkState.Connecting)))
                {
                    break;
                }
            }
        });
    }

    private string StateText(MemberWorkStatusDto status) =>
        L["workstate." + status.State.ToString().ToLowerInvariant()]
        + (status.ErrorText is { Length: > 0 } error ? $": {error}" : "");

    private static bool HasError(MemberWorkStatusDto status) => status.ErrorText is { Length: > 0 };

    /// <summary>Ошибка подключения участника — в окне с кнопкой «скопировать» (todo37).</summary>
    private Task ShowErrorAsync(MemberWorkStatusDto status)
    {
        var parameters = new DialogParameters<TextCopyDialog>
        {
            { d => d.Text, status.ErrorText ?? "" },
            { d => d.Caption, $"{status.Nick} — {L["workstate." + status.State.ToString().ToLowerInvariant()]}" },
        };
        return Dialogs.ShowAsync<TextCopyDialog>(L["teams.error.title"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private static Color StateColor(ExecutorWorkState state) => state switch
    {
        ExecutorWorkState.Connected or ExecutorWorkState.Online => Color.Success,
        ExecutorWorkState.Connecting => Color.Warning,
        ExecutorWorkState.Error => Color.Error,
        _ => Color.Default,
    };

    /// <summary>«Не активен» — кирпично-красный (todo_bugfix_3); в палитре MudBlazor его нет.</summary>
    private static string StateStyle(ExecutorWorkState state) => state == ExecutorWorkState.Inactive
        ? "background-color: #B22222; color: #fff;"
        : "";

    private static string StateIcon(ExecutorWorkState state) => state switch
    {
        ExecutorWorkState.Connected or ExecutorWorkState.Online => Icons.Material.Filled.CheckCircle,
        ExecutorWorkState.Connecting => Icons.Material.Filled.HourglassTop,
        ExecutorWorkState.Error => Icons.Material.Filled.ErrorOutline,
        ExecutorWorkState.Inactive => Icons.Material.Filled.PersonOff,
        _ => Icons.Material.Filled.RadioButtonUnchecked,
    };

    private async Task EditAsync(Team? team)
    {
        var parameters = new DialogParameters<TeamDialog> { { d => d.Source, team } };
        // широкий диалог: таблица состава с руководителем и тимлидом (ТЗ v1.18, todo21)
        var dialog = await Dialogs.ShowAsync<TeamDialog>(team is null ? L["teams.add"] : L["common.edit"],
            parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Team edited })
        {
            try
            {
                if (team is null)
                {
                    await Api.CreateTeamAsync(edited);
                }
                else
                {
                    await Api.UpdateTeamAsync(edited);
                }
                await State.RefreshReferenceDataAsync();
                await RefreshWorkAsync();
                State.NotifyChanged();
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
