@inject ApiClient Api
@inject I18nService L
@inject ISnackbar Snackbar

@* САЙТ ПЛАГИНА SaaS-РЕДАКТОРА (T-567-S0): короткое имя, Site ID, Account ID и ключ API.
   Ключ НАБИРАЕТСЯ здесь и уходит в secrets/ этого сервера; обратно он не приходит никогда,
   поэтому поле всегда начинается пустым, а пустое при записи значит «не менять». Короткое
   имя у существующего сайта не правится: по нему написаны правила безопасности. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width: 520px;" data-saas-site-form="1">
            <MudTextField @bind-Value="_site.Code" Label="@L["plugins.sites.code"]" ReadOnly="@IsEdit"
                          HelperText="ai2p" data-saas-site-code="1" />
            <MudTextField @bind-Value="_site.Name" Label="@L["plugins.sites.name"]" data-saas-site-name="1" />
            <MudTextField @bind-Value="_site.Url" Label="@L["plugins.sites.url"]" data-saas-site-url="1" />
            <MudTextField @bind-Value="_site.SiteId" Label="@L["plugins.sites.siteId"]" data-saas-site-id="1" />
            <MudTextField @bind-Value="_site.AccountId" Label="@L["plugins.sites.accountId"]" data-saas-site-account="1" />
            <MudTextField @bind-Value="_site.Key" Label="@L["plugins.sites.key"]" InputType="InputType.Password"
                          HelperText="@KeyHint" data-saas-site-key="1" />
            <MudTextField @bind-Value="_site.Note" Label="@L["plugins.sites.note"]" Lines="2" data-saas-site-note="1" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_busy"
                   data-saas-site-save="1" OnClick="SaveAsync">@L["common.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Код плагина: <c>saas.wix</c>.</summary>
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    /// <summary>Правимый сайт; null — новый.</summary>
    [Parameter] public SaasSiteDto? Site { get; set; }

    private SaasSiteDto _site = new();
    private bool _busy;

    private bool IsEdit => Site is not null;

    private string KeyHint => Site is null ? "" : Site.OwnKey ? L["plugins.sites.keySet"]
        : Site.HasKey ? L["plugins.sites.keyShared"] : L["plugins.sites.keyNone"];

    protected override void OnInitialized()
    {
        if (Site is not null)
        {
            _site = new SaasSiteDto
            {
                Code = Site.Code, Name = Site.Name, Url = Site.Url, SiteId = Site.SiteId,
                AccountId = Site.AccountId, Note = Site.Note,
            };
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            _site.Code = (_site.Code ?? "").Trim();
            await Api.SavePluginSiteAsync(Code, _site);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
