    /// <summary>
    /// ПОДДЕРЕВО ЗАДАЧИ (T-132-S0) из уже прочитанного списка задач проекта: представлению
    /// «иерархия» нужны не только прямые потомки, а вся ветка. Обход с защитой от кольца
    /// (испорченный parent_id) — иначе список подзадач вешал бы карточку.
    /// </summary>
    private static List<TaskItem> Subtree(List<TaskItem> candidates, string rootId)
    {
        var byParent = candidates.Where(t => t.ParentId is not null).ToLookup(t => t.ParentId!);
        var result = new List<TaskItem>();
        var seen = new HashSet<string>(StringComparer.Ordinal);
        var queue = new Queue<string>();
        queue.Enqueue(rootId);
        while (queue.Count > 0)
        {
            foreach (var child in byParent[queue.Dequeue()])
            {
                if (seen.Add(child.Id))
                {
                    result.Add(child);
                    queue.Enqueue(child.Id);
                }
            }
        }
        return result;
    }

    /// <summary>
    /// ДЕЙСТВИЕ НАД ПОДЗАДАЧЕЙ ИЗ ДИАГРАММЫ (T-132-S0): контекстное меню квадрата зовёт
    /// ровно те же руки, что и кнопки строки таблицы, — чтобы поведение (переспросы,
    /// сообщения, перечитывание) не разъезжалось между представлениями.
    /// </summary>
    private async Task RunSubtaskActionAsync((string Action, string TaskId) request)
    {
        if (request.Action == "link")
        {
            await ShowLinkAsync(request.TaskId);
            return;
        }
        TaskItem subtask;
        try
        {
            subtask = _subtree.FirstOrDefault(t => t.Id == request.TaskId)
                      ?? (await Api.GetTaskAsync(request.TaskId)).Task;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        switch (request.Action)
        {
            case "edit":
                await EditSubtaskAsync(subtask);
                break;
            case "status":
                await ChangeSubtaskStatusAsync(subtask);
                break;
            case "delete":
                await DeleteSubtaskAsync(subtask);
                break;
            case "start":
            case "stop":
                try
                {
                    if (request.Action == "start")
                    {
                        await Api.StartTaskAsync(subtask.Id);
                    }
                    else
                    {
                        await Api.StopTaskAsync(subtask.Id, false, false);
                        Snackbar.Add(L["task.stop.done"], Severity.Success);
                    }
                    await ReloadAsync();
                    State.NotifyChanged();
                }
                catch (ApiException ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                }
                break;
        }
    }

