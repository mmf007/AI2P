        {
            return;
        }
        var target = task.IsTemplate ? ArchiveMoveTargets.Template : ArchiveMoveTargets.Task;
        var choice = await ArchiveOrDeleteDialog.AskAsync(Dialogs, L["common.delete"],
            target, TaskId, $"{task.DisplayId} {task.Title}");
        if (choice is null)
        {
            return;
        }
        try
        {
            if (choice == ArchiveOrDeleteDialog.Archive)
            {
                await Api.MoveToArchiveAsync(target, TaskId);
            }
            else
            {
                await Api.DeleteTaskAsync(TaskId);
            }
            State.CloseEntityTab(UiState.ViewTask, TaskId);
            State.NotifyChanged();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Ссылка на задачу — отдельное окно с кнопкой копирования (гл. 11).
    /// Ссылок две (T-142): локальная (петлевая) и внешняя — по имени сервера из настроек;
    /// у сервера с петлевым именем внешней нет, и окно показывает одну, как раньше.</summary>
    /// <summary>Окно ссылки на задачу: своей (кнопка тулбара) либо подзадачи из списка
    /// (T-132-S0) — окно одно и то же, меняется только адрес.</summary>
    private Task ShowLinkAsync(string? id = null)
    {
        var taskId = id ?? TaskId;
        var parameters = new DialogParameters<TaskLinkDialog>
        {
            { d => d.Url, State.TaskUrl(taskId) },
            { d => d.LocalUrl, State.HasExternalUrl ? State.TaskLocalUrl(taskId) : "" },
            // относительная — от корня сайта (T-196-S0): не зависит от протокола и адреса
            { d => d.RelativeUrl, LinkUrls.RelativeOf(State.TaskUrl(taskId)) },
        };
        // окно шире Small (T-142): ссылка на файл проекта с процентным кодированием длинная,
        // а её в этом окне читают глазами — обрезанный адрес бесполезен
        return Dialogs.ShowAsync<TaskLinkDialog>(L["task.link"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private static readonly string[] ImageFileExtensions =
        [".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg"];

    private static readonly string[] VideoFileExtensions = [".mp4", ".webm", ".mov", ".mkv", ".avi"];

    private static string FileExtension(TaskFileDto file) =>
        System.IO.Path.GetExtension(file.Name).ToLowerInvariant();

    private static bool IsImageFile(TaskFileDto file) =>
        ImageFileExtensions.Contains(FileExtension(file));

    private static string FileKindIcon(TaskFileDto file) =>
        VideoFileExtensions.Contains(FileExtension(file))
            ? Icons.Material.Filled.Movie
            : Icons.Material.Filled.InsertDriveFile;

    /// <summary>Адрес, по которому файл открывается и показывается превью (T-142):
    /// есть локальная копия — берётся она, файл в гигабайты не должен ехать по сети.</summary>
    private static string FileOpenUrl(TaskFileDto file) =>
        file.LocalUrl.Length > 0 ? file.LocalUrl : file.Url;

    /// <summary>Ссылка на файл результата (T-127-S0) — тем же окном, что ссылка на задачу:
    /// внешняя (её отправляют наружу) и локальная. Адреса АБСОЛЮТНЫЕ: относительный
    /// вне приложения бесполезен.</summary>
    private Task ShowFileLinkAsync(TaskFileDto file)
    {
        var external = AbsoluteUrl(file.ExternalUrl.Length > 0 ? file.ExternalUrl : file.Url);
        var local = file.LocalUrl.Length > 0 ? AbsoluteUrl(file.LocalUrl) : "";
        var parameters = new DialogParameters<TaskLinkDialog>
        {
            { d => d.Url, external },
            { d => d.LocalUrl, local },
            // относительная — только у НАШЕГО файла (T-196-S0): у ссылки на внешний сайт
            // путь от нашего корня ничего не значит
            { d => d.RelativeUrl, FileLinks.Parse(file.Url) is null
                ? "" : LinkUrls.RelativeOf(local.Length > 0 ? local : external) },
        };
        return Dialogs.ShowAsync<TaskLinkDialog>(file.Name, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    /// <summary>Относительный адрес — от адреса, по которому открыт экран. Берётся
    /// <c>AbsoluteUri</c>, а не <c>ToString()</c>: второй раскрывает процентное кодирование,
    /// и кириллица в имени файла уезжала в буфер обмена голыми буквами.</summary>
    private string AbsoluteUrl(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var absolute)
            ? absolute.AbsoluteUri
            : Nav.ToAbsoluteUri(url).AbsoluteUri;

    // --- правка текста результата (T-130-S0) ---

    /// <summary>Открыть текст на правку: черновик берётся из уже прочитанного текста —
    /// перечитывать файл не нужно, он в <see cref="_artifactTexts"/>.</summary>
    private void StartArtifactEdit(string artifact)
    {
        _editingArtifact = artifact;
        _artifactDraft = _artifactTexts.TryGetValue(artifact, out var text) ? text : "";
    }

    /// <summary>«Отмена» — выход из правки без записи; черновик просто выбрасывается,
    /// перечитывать карточку не надо (текст на экране и так из <see cref="_artifactTexts"/>).</summary>
    private void CancelArtifactEdit()
    {
        _editingArtifact = null;
        _artifactDraft = "";
    }

    /// <summary>Записать правленый текст результата и вернуться в режим чтения. Карточка
    /// перечитывается: тем же файлом кормится и кнопка копирования, и сводка карточки.</summary>
    private async Task SaveArtifactTextAsync()
    {
        if (_editingArtifact is not { } artifact)
        {
            return;
        }
        try
        {
            await Api.SaveFileTextAsync(artifact, _artifactDraft);
            _editingArtifact = null;
            _artifactDraft = "";
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Удалить файл результата (T-127-S0): с переспросом отдельным окном,
    /// после удаления карточка перечитывается — из списка уходит и сам файл, и его описание.</summary>
    private async Task DeleteArtifactFileAsync(TaskFileDto file)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["task.files.delete"],
            $"{L["task.files.deleteConfirm"]}\n\n{file.Name}",
            yesText: L["common.delete"], cancelText: L["common.cancel"]);
        if (confirmed != true)
        {
            return;
        }
        try
        {
            await Api.DeleteTaskFileAsync(TaskId, file.Path);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Ответ на вопрос ИИ-агента (ТЗ v1.17): агент продолжает работу с того же места.</summary>
    private async Task AnswerQuestionAsync(string questionId, string text)
    {
        if (text.Trim().Length == 0)
        {
            return;
        }
        _answering = true;
        try
        {
            await Api.AnswerQuestionAsync(questionId, text.Trim());
            QuestionReply = "";
            await ReloadAsync();
            State.NotifyChanged(); // счётчики вопросов в списках задач обновятся
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _answering = false;
        }
    }

    /// <summary>
    /// Вопрос, отвечать на который уже некому (T-1-S1): его задание больше не ждёт —
    /// упало, остановлено или завершилось (а бывает, что задания у вопроса нет вовсе).
    /// Ровно на такой вопрос ответ отклоняется сообщением «задание уже не ждёт ответа»,
    /// поэтому вместо поля ответа человеку показывается кнопка «снять вопрос».
    /// </summary>
    private bool IsStaleQuestion(ChatMessage message) =>
        _details is null
        || message.JobId is not { Length: > 0 } jobId
        || _details.Jobs.FirstOrDefault(j => j.Id == jobId) is not { State: JobState.WaitingHuman };

    /// <summary>Есть ли у вопроса настоящий ответ (T-1-S1): ответ человека либо сообщение
    /// агента-собеседника (T-185). У снятого вопроса его нет — он закрыт без ответа.</summary>
    private bool HasReply(ChatMessage question) =>
        _chat.Any(m => m.AnswerToId == question.Id && m.DeletedAt is null);

    /// <summary>Снять вопрос, на который уже некому отвечать (T-1-S1): он закрывается без
    /// ответа и уходит из счётчиков задачи, из вкладки чата и из Inbox.</summary>
    private async Task DismissQuestionAsync(string questionId)
    {
        _answering = true;
        try
        {
            await Api.DismissQuestionAsync(questionId);
            await ReloadAsync();
            State.NotifyChanged(); // счётчики вопросов в списках задач обновятся
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _answering = false;
        }
    }

    private async Task SendChatAsync()
    {
        try
        {
            // адресат — ответственный по задаче (ТЗ п. 7.2), если он не автор сообщения
            var to = _details?.Task.ResponsibleId == State.LocalUser.Id ? null : _details?.Task.ResponsibleId;
            await Api.PostChatAsync(TaskId, ChatText, to);
            ChatText = "";
            _chat = await Api.GetChatAsync(TaskId);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
