    /// <summary>
    /// ВОССТАНОВИТЬ ЗАДАЧУ ИЗ ТЕКУЩЕГО АРХИВА в рабочую среду (T-45-S0; механика — T-42-S0):
    /// операция, обратная архивации. Уезжает вся иерархия задачи, её файлы, а ссылки внутри
    /// текстов теряют пометку архива. Вызов идёт в раздел /api/archives, который работает
    /// с РАБОЧЕЙ средой всегда, — потому он и проходит при открытом архиве.
    /// После восстановления задачи в архиве уже нет: закладку закрываем.
    /// </summary>
    private async Task RestoreAsync()
    {
        if (_details?.Task is not { } task || _restoring)
        {
            return;
        }
        var target = task.IsTemplate ? ArchiveMoveTargets.Template : ArchiveMoveTargets.Task;
        var ok = await Dialogs.ShowMessageBoxAsync(L["arc.restore"],
            L["arc.restore.confirm", $"{task.DisplayId} {task.Title}"],
            yesText: L["arc.restore"], cancelText: L["common.cancel"]);
        if (ok != true)
        {
            return;
        }
        _restoring = true;
        try
        {
            await Api.RestoreFromArchiveAsync(target, TaskId);
            Snackbar.Add(L["arc.restore.done"], Severity.Success);
            State.CloseEntityTab(UiState.ViewTask, TaskId);
            State.NotifyChanged();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _restoring = false;
        }
    }

    private async Task DeleteAsync()
    {
