@inject I18nService L
@inject UiState State

@* Диалог смены статуса задачи (ТЗ v1.14): вызывается кнопкой рядом со статусом на карточке
   задачи — ручная смена статуса человеком в дополнение к перетаскиванию на доске.
   Список — активные состояния справочника состояний по порядковому номеру (ТЗ v1.37);
   текущее состояние показывается, даже если его деактивировали.
   Варианты — радиокнопками (T-130): выбор виден целиком и делается одним кликом, а не
   раскрытием списка; цвет состояния из справочника остаётся на глазах. *@
<MudDialog>
    <DialogContent>
        <MudRadioGroup T="string" @bind-Value="_status">
            <MudStack Spacing="0">
                @foreach (var status in Options)
                {
                    <MudRadio T="string" Value="@status.Id" Dense="true">
                        <MudChip T="string" Size="Size.Small" Style="@State.StatusStyle(status.Id)">
                            @status.Name
                        </MudChip>
                    </MudRadio>
                }
            </MudStack>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="@(() => Dialog.Close(DialogResult.Ok(_status)))">@L["common.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Текущий статус задачи (код состояния).</summary>
    [Parameter] public string Current { get; set; } = TaskStatuses.Draft;

    private string _status = TaskStatuses.Draft;

    private IEnumerable<TaskStatusDef> Options =>
        State.TaskStatuses.Where(s => s.IsActive || s.Id == Current);

    protected override void OnInitialized() => _status = Current;
}
