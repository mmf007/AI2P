    /// <summary>
    /// ЗАПУСК ОБУЧЕНИЯ. У обученной модели переспрашиваем: переобучение затирает готовый
    /// файл адаптера, который мог быть уже подставлен в модель, — и отменить это нечем.
    /// </summary>
    private async Task TrainAsync(ObjectLoraModel row)
    {
        var force = row.Status == LoraModelStates.Ready;
        if (force)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(L["lora.model.train"],
                string.Format(L["lora.model.retrainConfirm"], row.ModelName),
                yesText: L["lora.model.retrain"], cancelText: L["common.cancel"]);
            if (confirmed != true)
            {
                return;
            }
        }
        // О ЧЁМ СПРОСИТЬ ПЕРЕД ЗАПУСКОМ (T-274). Оба вопроса — про то, что обучение молча
        // сделает не то, чего ждут: возьмёт другой датасет либо кадры, которых модель не
        // примет. Те же условия сервер проверяет сам — форма только задаёт вопрос
        var dataset = _datasetId;
        var confirmDataset = false;
        LoraTrainCheck check;
        try
        {
            check = await Api.CheckLoraTrainAsync(row.Id, dataset);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        if (check.DatasetChanged)
        {
            // ТРИ ответа, а не два: «по текущему», «по тому, по которому обучали» и «отмена».
            // Второй нужен именно здесь: адаптер, обученный на других кадрах, — это другой
            // персонаж, и человек, переключивший датасет ради кадров, о прошлом обучении
            // мог и не помнить
            var answer = await Dialogs.ShowMessageBoxAsync(L["lora.model.train"],
                string.Format(L["lora.dataset.changed"], check.TrainedDatasetName, check.DatasetName),
                yesText: string.Format(L["lora.dataset.useCurrent"], check.DatasetName),
                noText: string.Format(L["lora.dataset.useTrained"], check.TrainedDatasetName),
                cancelText: L["common.cancel"]);
            if (answer is null)
            {
                return;
            }
            if (answer == true)
            {
                confirmDataset = true;
            }
            else
            {
                // обучаем по запомненному — датасет не менялся, и переспрашивать не о чем,
                // но сверку настроек надо повторить: у того датасета они свои
                dataset = check.TrainedDatasetId;
                try
                {
                    check = await Api.CheckLoraTrainAsync(row.Id, dataset);
                }
                catch (ApiException ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                    return;
                }
            }
        }
        // НЕСОВПАДЕНИЕ НАСТРОЕК С МОДЕЛЬЮ. Ответов три: обучать как есть, ОТМЕНИТЬ и —
        // с T-57-S0 — «создать/переключить на нужный датасет»: не человеку же руками заводить
        // датасет, переписывать в него настройки из модели и пережимать полсотни картинок.
        // После пережатия сверку повторяем (датасет-то другой), а кнопку пережатия во второй
        // раз не показываем: если она не помогла, не поможет и повтор
        var confirmLimits = false;
        var fitted = false;
        while (check.Warnings.Count > 0)
        {
            var answer = await Dialogs.ShowMessageBoxAsync(L["lora.model.train"],
                string.Format(L["lora.limits.mismatch"], row.ModelName,
                    string.Join("; ", check.Warnings)),
                yesText: L["lora.limits.trainAnyway"],
                noText: fitted ? null : L["lora.dataset.fit"],
                cancelText: L["common.cancel"]);
            if (answer is null)
            {
                return;
            }
            if (answer == true)
            {
                confirmLimits = true;
                break;
            }
            if (await FitDatasetAsync(row, dataset) is not { } fit)
            {
                return;
            }
            fitted = true;
            dataset = fit;
            // обучать будем по ДРУГОМУ датасету, чем в прошлый раз, и это выбор человека,
            // сделанный только что, — второй раз о том же не спрашиваем
            confirmDataset = true;
            _datasetId = fit;
            await ReloadAsync();
            try
            {
                check = await Api.CheckLoraTrainAsync(row.Id, dataset);
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
        }
        // ДАЛЬШЕ ОБУЧЕНИЕ ЗАПУСКАЕТСЯ ЗАДАЧЕЙ (T-157-S0), а не фоном сервиса: у задачи есть
        // консоль, лог, кнопка остановки, планирование и место в иерархии. Прямого запуска у
        // клиента больше нет — два пути к одной работе разъезжаются молча
        await CreateTrainTaskAsync(row, dataset, force, confirmDataset, confirmLimits);
    }

    /// <summary>
    /// ОБУЧЕНИЕ ЗАДАЧЕЙ (T-157-S0) — то, что происходит ПОСЛЕ проверок датасета. Порядок ровно
    /// такой, как заказан: ищем годный узел шаблонов; нет шаблона, но есть исполнитель —
    /// предлагаем завести шаблон; нет исполнителя — предлагаем завести его из записи «Плагинов
    /// и MCP»; нет плагина вовсе — отправляем в окно установки плагина. И только потом
    /// переспрашиваем «создать и запустить / только создать / отмена».
    ///
    /// Заголовок, описание, исполнителя и тэги человек не пишет ни на одном шаге: они приезжают
    /// из узла шаблона вместе с его опытом.
    /// </summary>
    private async Task CreateTrainTaskAsync(ObjectLoraModel row, string? dataset, bool force,
        bool confirmDataset, bool confirmLimits)
    {
        LoraTrainOptionsDto options;
        try
        {
            options = await Api.GetLoraTrainOptionsAsync(row.Id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        // обучать нечем: модель не работает с LoRA либо плагина-тренера нет вовсе. Текст
        // отказа человеку надо ПРОЧИТАТЬ — искать его в подсказке на слове «ошибка» поздно
        if (options.Error.Length > 0 || options.PluginCode.Length == 0)
        {
            Snackbar.Add(options.Error.Length > 0 ? options.Error : L["lora.task.noPlugin"],
                Severity.Error);
            return;
        }
        // ПЛАГИН ЕСТЬ, НО НЕ ГОТОВ — программа не найдена на этом компьютере. Отправляем в то
        // самое окно установки плагина: сами мы её не поставим, а задача без программы встала
        // бы в очередь и не тронулась с места
        if (!options.PluginReady)
        {
            var install = await Dialogs.ShowMessageBoxAsync(L["lora.model.train"],
                string.Format(L["lora.task.pluginNotReady"], options.PluginName),
                yesText: L["lora.task.openPlugin"], cancelText: L["common.cancel"]);
            if (install == true)
            {
                var parameters = new DialogParameters<PluginInstallDialog>
                {
                    { d => d.Code, options.PluginCode },
                };
                var dialog = await Dialogs.ShowAsync<PluginInstallDialog>(
                    L["plugins.setup"] + " — " + options.PluginName, parameters,
                    new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
                await dialog.Result;
            }
            return;
        }
        // ИСПОЛНИТЕЛЯ НЕТ — заводим его из записи «Плагинов и MCP» с уже подставленной
        // программой и операцией: выбирать их человеку значило бы спрашивать про внутренности
        // манифеста, которых он не видел
        if (options.ExecutorId.Length == 0)
        {
            var make = await Dialogs.ShowMessageBoxAsync(L["lora.model.train"],
                string.Format(L["lora.task.noExecutor"], options.PluginName),
                yesText: L["lora.task.makeExecutor"], cancelText: L["common.cancel"]);
            if (make != true)
            {
                return;
            }
            try
            {
                var executor = await Api.CreateLoraTrainExecutorAsync(row.Id);
                Snackbar.Add(string.Format(L["lora.task.executorMade"], executor.Nick),
                    Severity.Success);
                options = await Api.GetLoraTrainOptionsAsync(row.Id);
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
        }
        // ШАБЛОНА НЕТ — заводим узел с этим исполнителем. Дальше он и будет источником
        // заголовка, описания и тэгов КАЖДОГО обучения, и править их человек станет в одном
        // месте, а не в каждой задаче
        if (options.Templates.Count == 0)
        {
            var make = await Dialogs.ShowMessageBoxAsync(L["lora.model.train"],
                string.Format(L["lora.task.noTemplate"], options.ExecutorNick),
                yesText: L["lora.task.makeTemplate"], cancelText: L["common.cancel"]);
            if (make != true)
            {
                return;
            }
            try
            {
                var node = await Api.CreateLoraTrainTemplateAsync(row.Id, options.ExecutorId);
                Snackbar.Add(string.Format(L["lora.task.templateMade"], node.DisplayId),
                    Severity.Success);
                options = await Api.GetLoraTrainOptionsAsync(row.Id);
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            if (options.Templates.Count == 0)
            {
                Snackbar.Add(L["lora.task.noTemplateStill"], Severity.Error);
                return;
            }
        }
        // ВЫБОР ШАБЛОНА И ПЕРЕСПРОС «КАК ЗАПУСТИТЬ» — одним окном: вопросы про одно решение
        var pick = new DialogParameters<LoraTrainTaskDialog>
        {
            { d => d.Templates, options.Templates },
        };
        var ask = await Dialogs.ShowAsync<LoraTrainTaskDialog>(L["lora.model.train"], pick,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var answer = await ask.Result;
        if (answer is not { Canceled: false, Data: LoraTrainTaskCreateDto wanted })
        {
            return;
        }
        try
        {
            var created = await Api.CreateLoraTrainTaskAsync(row.Id, wanted.TemplateId, dataset,
                wanted.Run, force, confirmDataset, confirmLimits);
            // «создана, но не запустилась» — не ошибка создания: занятая программа и чужой
            // сервер означают «задача подождёт», и сказать об этом надо отдельно
            Snackbar.Add(string.Format(created.Started
                    ? L["lora.task.started"]
                    : L["lora.task.created"], created.DisplayId),
                Severity.Success);
            if (created.StartError.Length > 0)
            {
                Snackbar.Add(created.StartError, Severity.Warning);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadModelsAsync();
    }

    /// <summary>
    /// СОЗДАТЬ/ПЕРЕКЛЮЧИТЬ НА НУЖНЫЙ ДАТАСЕТ (T-57-S0). Возвращает датасет, по которому
    /// можно обучать, либо null — если не вышло (о чём человеку уже сказано).
    ///
    /// Что делает сервер: ищет подходящий среди уже заведённых датасетов объекта и, найдя,
    /// делает его текущим — тогда пережимать нечего вовсе. Не нашёл — заводит новый с
    /// настройками из модели и присылает список кадров-исходников. Пережимает их БРАУЗЕР,
    /// холстом (ai2p.loraFitImage), по тому же правилу, по которому режется кадр при
    /// добавлении: картинка вписывается в кадр целиком, поля закрашиваются цветом настройки.
    /// </summary>
    private async Task<string?> FitDatasetAsync(ObjectLoraModel row, string datasetId)
    {
        LoraDatasetFitDto fit;
        try
        {
            fit = await Api.FitLoraDatasetAsync(row.Id, datasetId);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return null;
        }
        if (fit.Found)
        {
            Snackbar.Add(string.Format(L["lora.dataset.fit.found"], fit.DatasetName), Severity.Success);
            return fit.DatasetId;
        }
        var done = 0;
        var failed = new List<string>();
        foreach (var frame in fit.Frames)
        {
            try
            {
                var image = await Js.InvokeAsync<CropResult?>("ai2p.loraFitImage",
                    FrameUrlOf(frame.Path), fit.Limits.MaxWidth, fit.Limits.MaxHeight,
                    fit.Limits.MaxKb, fit.Limits.Format, fit.PadColor);
                if (image is null || image.Data.Length == 0
                    || image.Bytes > fit.Limits.MaxKb * 1024L)
                {
                    failed.Add(frame.FileName);
                    continue;
                }
                await Api.AddLoraFrameAsync(Item.Id, new LoraDatasetAddDto
                {
                    FileName = frame.FileName,
                    Description = frame.Description,
                    DataBase64 = image.Data,
                    DatasetId = fit.DatasetId,
                });
                done++;
            }
            catch (ApiException ex)
            {
                // один кадр не переехал — это не повод бросать остальные: датасет из
                // сорока девяти кадров всё ещё годится, а о пропущенных мы скажем
                failed.Add(frame.FileName + ": " + ex.Message);
            }
        }
        if (done == 0)
        {
            Snackbar.Add(L["lora.dataset.fit.failed"], Severity.Error);
            return null;
        }
        Snackbar.Add(string.Format(L["lora.dataset.fit.done"], fit.DatasetName, done), Severity.Success);
        if (failed.Count > 0)
        {
            Snackbar.Add(string.Format(L["lora.dataset.fit.skipped"], string.Join(", ", failed)),
                Severity.Warning);
        }
        return fit.DatasetId;
    }

    /// <summary>Ссылка на файл кадра — по ней его читает холст браузера. Кадр датасета лежит
    /// в каталоге данных организации (T-98-S0), кадр прежних версий — в папке проекта;
    /// откуда его брать, говорит сам путь.</summary>
    private string FrameUrlOf(string path) =>
        ObjectFiles.Link(path, Item.ProjectId) is { } link ? FileLinks.Relative(link) : "";

    /// <summary>Что вернул холст браузера: готовая картинка (base64) и её размеры.</summary>
    private sealed class CropResult
    {
        public string Data { get; set; } = "";
        public int Width { get; set; }
        public int Height { get; set; }
        public long Bytes { get; set; }
    }

    private async Task StopAsync(ObjectLoraModel row)
    {
        try
        {
            await Api.CancelLoraTrainAsync(row.Id);
            await LoadModelsAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        _poll?.Cancel();
        _poll = null;
    }
}
