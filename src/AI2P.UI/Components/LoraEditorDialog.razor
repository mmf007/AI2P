@implements IDisposable
@inject ApiClient Api
@inject I18nService L
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime Js

@* РЕДАКТОР LoRA (T-12-S1, версия 1.95) — то, что открывается кнопкой «настройка LoRA»
   формы объекта вместо трёх прежних кнопок-заглушек (T-259).

   Форма собрана ровно по заданию: поле описания и две закладки — ДАТАСЕТ и МОДЕЛИ. За этим
   делением стоит смысл: датасет один на объект (персонажа учат по одним и тем же кадрам),
   а обучение — своё под каждую модель, потому что веса у моделей разные и файл, обученный
   для одной, к другой не подходит.

   ЧТО СОХРАНЯЕТСЯ КОГДА. Кадры и строки обучения — сами по себе, каждым действием сразу:
   это отдельные записи, и держать их в памяти формы до нажатия «сохранить» значило бы
   потерять обучение, которое идёт часами, от случайного «отмена». А ОПИСАНИЕ принадлежит
   объекту и возвращается в его форму — там его и сохранят вместе с остальным. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 520px;">
            @* СПРАВКА ПО РЕДАКТОРУ (T-273): что писать в описаниях, что из них уедет в
               обучение, как запускать обучение. Открывается окном ПОВЕРХ формы — уходить
               из формы за справкой нельзя, набранное описание пропало бы *@
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.MenuBook" Color="Color.Info"
                               Size="Size.Small" data-lora-doc="1" title="@L["lora.doc"]"
                               OnClick="OpenDocAsync" />
            </MudStack>

            @* ОПИСАНИЕ — это паспорт самого объекта: у адаптера LoRA он и есть описание того,
               чему адаптер обучен. Второго описания заводить не стали: два поля с одинаковым
               названием в двух формах — верный способ получить два разных текста *@
            <MudTextField T="string" @bind-Value="_description" Label="@L["lora.description"]"
                          Lines="4" Variant="Variant.Outlined" data-lora-description="1"
                          HelperText="@L["lora.description.hint"]" />

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
                @* --- ЗАКЛАДКА 1: ДАТАСЕТ --- *@
                <MudTabPanel Text="@L["lora.tab.dataset"]" data-lora-tab="dataset">
                    <MudStack Spacing="2">
                        @* ТЕКУЩИЙ ДАТАСЕТ (T-274). Датасетов у объекта несколько — у разных
                           моделей разные требования к картинкам, — и всё на этой закладке
                           относится к ВЫБРАННОМУ: и кадры, и настройки контроля *@
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (_datasets is null)
                            {
                                <MudProgressLinear Indeterminate="true" Class="flex-grow-1" />
                            }
                            else
                            {
                                <MudSelect T="string" Value="@_datasetId" ValueChanged="PickDatasetAsync"
                                           Label="@L["lora.dataset.current"]" Class="flex-grow-1"
                                           data-lora-dataset-pick="1" Dense="true"
                                           ToStringFunc="@NameOfDataset">
                                    @foreach (var set in _datasets)
                                    {
                                        <MudSelectItem T="string" Value="@set.Id">
                                            @set.Name (@set.Frames)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                               data-lora-dataset-add="1" title="@L["lora.dataset.add"]"
                                               OnClick="AddDatasetAsync" />
                            }
                        </MudStack>

                        @* НАСТРОЙКИ КОНТРОЛЯ КАРТИНОК ЭТОГО ДАТАСЕТА. Переписаны из общих
                           настроек при заведении и правятся здесь: требования к кадрам —
                           свойство модели, а не приложения *@
                        <MudExpansionPanels Elevation="0" data-lora-limits-panel="1">
                            <MudExpansionPanel Text="@L["lora.limits"]">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Spacing="2">
                                        <MudNumericField T="int" @bind-Value="_limits.MaxWidth" Min="16" Max="8192"
                                                         Label="@L["settings.lora.maxWidth"]"
                                                         data-lora-limit-width="1" />
                                        <MudNumericField T="int" @bind-Value="_limits.MaxHeight" Min="16" Max="8192"
                                                         Label="@L["settings.lora.maxHeight"]"
                                                         data-lora-limit-height="1" />
                                        <MudNumericField T="int" @bind-Value="_limits.MaxKb" Min="16" Max="102400"
                                                         Label="@L["settings.lora.maxKb"]"
                                                         data-lora-limit-kb="1" />
                                        <MudSelect T="string" @bind-Value="_limits.Format"
                                                   Label="@L["settings.lora.format"]"
                                                   data-lora-limit-format="1">
                                            <MudSelectItem T="string" Value="@("png")">PNG</MudSelectItem>
                                            <MudSelectItem T="string" Value="@("jpeg")">JPEG</MudSelectItem>
                                        </MudSelect>
                                    </MudStack>
                                    <MudStack Row="true" Spacing="2">
                                        <MudNumericField T="int" @bind-Value="_limits.MinItems" Min="0" Max="10000"
                                                         Label="@L["lora.limits.minItems"]"
                                                         data-lora-limit-min="1" />
                                        <MudNumericField T="int" @bind-Value="_limits.MaxItems" Min="0" Max="10000"
                                                         Label="@L["lora.limits.maxItems"]"
                                                         data-lora-limit-max="1" />
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @L["lora.limits.hint"]
                                    </MudText>
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                        @* ПОДСТАВИТЬ ИЗ МОДЕЛИ: в списке только те модели закладки
                                           «Модели», у которых в справочнике заполнены контрольные
                                           настройки — подставлять из молчащей модели нечего *@
                                        @if (_modelLimits is { Count: > 0 })
                                        {
                                            <MudMenu Label="@L["lora.limits.fromModel"]"
                                                     Variant="Variant.Outlined" Color="Color.Primary"
                                                     data-lora-limits-frommodel="1">
                                                @foreach (var model in _modelLimits)
                                                {
                                                    <MudMenuItem OnClick="@(() => TakeFromModel(model))"
                                                                 data-lora-limits-model="@model.ModelDisplayId">
                                                        @model.ModelDisplayId @model.ModelName
                                                    </MudMenuItem>
                                                }
                                            </MudMenu>
                                        }
                                        <MudSpacer />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   Disabled="@(_datasetId.Length == 0)"
                                                   data-lora-limits-save="1" OnClick="SaveLimitsAsync">
                                            @L["common.save"]
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                           data-lora-frame-add="1" title="@L["lora.frame.add"]"
                                           OnClick="AddFrameAsync" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     data-lora-frame-count="@(_frames?.Count ?? 0)">
                                @string.Format(L["lora.frame.count"], _frames?.Count ?? 0)
                            </MudText>
                        </MudStack>
                        @if (_frames is null)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (_frames.Count == 0)
                        {
                            <MudText Typo="Typo.body2" data-lora-dataset-empty="1">@L["lora.frame.empty"]</MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" data-lora-dataset="1">
                                <tbody>
                                @foreach (var frame in _frames)
                                {
                                    <tr data-lora-frame="@frame.DisplayId">
                                        @* ПРЕВЬЮ обязательно: кадры отличают глазами, по именам
                                           «001.png» и «002.png» не отличить ничего *@
                                        <td style="width: 96px;">
                                            <img src="@FrameUrl(frame)" alt="@frame.Name" loading="lazy"
                                                 data-lora-frame-img="1"
                                                 style="width: 84px; height: 84px; object-fit: contain;" />
                                        </td>
                                        <td>
                                            <MudText Typo="Typo.body2"><b>@frame.Name</b></MudText>
                                            <MudText Typo="Typo.caption" data-lora-frame-caption="1"
                                                     Style="overflow-wrap: anywhere;">
                                                @frame.Description
                                            </MudText>
                                        </td>
                                        <td style="width: 96px; text-align: right;">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                           data-lora-frame-edit="@frame.DisplayId"
                                                           title="@L["common.edit"]"
                                                           OnClick="@(() => EditFrameAsync(frame))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                           data-lora-frame-del="@frame.DisplayId"
                                                           title="@L["common.delete"]"
                                                           OnClick="@(() => DeleteFrameAsync(frame))" />
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudStack>
                </MudTabPanel>

                @* --- ЗАКЛАДКА 2: МОДЕЛИ --- *@
                <MudTabPanel Text="@L["lora.tab.models"]" data-lora-tab="models">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                           data-lora-model-add="1" title="@L["lora.model.add"]"
                                           OnClick="AddModelAsync" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @L["lora.model.hint"]
                            </MudText>
                        </MudStack>
                        @if (_models is null)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (_models.Count == 0)
                        {
                            <MudText Typo="Typo.body2" data-lora-models-empty="1">@L["lora.model.empty"]</MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" data-lora-models="1">
                                <thead>
                                <tr>
                                    <th>@L["lora.model.id"]</th>
                                    <th>@L["lora.model.code"]</th>
                                    <th>@L["lora.model.status"]</th>
                                    <th style="text-align: right;"></th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var row in _models)
                                {
                                    <tr data-lora-model="@row.ModelDisplayId">
                                        <td data-lora-model-id="1">@row.ModelDisplayId</td>
                                        <td data-lora-model-code="1">@row.ModelName</td>
                                        @* СОСТОЯНИЕ. У ошибки в подсказке — то, что сказали
                                           процесс обучения или API: без этого от слова
                                           «ошибка» нет никакой пользы *@
                                        <td data-lora-model-status="@row.Status"
                                            title="@(row.Status == LoraModelStates.Error ? row.Error : null)">
                                            @* СОСТОЯНИЕ — ССЫЛКА НА ЗАДАЧУ ОБУЧЕНИЯ (T-157-S0):
                                               обучение идёт задачей, и в её карточке лежит всё,
                                               ради чего оно ею стало — консоль, лог и кнопка
                                               остановки. Ссылка есть у ЛЮБОГО состояния, лишь бы
                                               задача была известна: к упавшему обучению человек
                                               приходит через сутки именно за логом *@
                                            @if (row.TrainTaskDisplayId.Length > 0)
                                            {
                                                <MudLink Typo="Typo.body2" Color="@StatusColor(row.Status)"
                                                         Href="@($"task/{row.TrainTaskId}")"
                                                         data-lora-model-task="@row.TrainTaskDisplayId"
                                                         title="@L["lora.task.open"]">
                                                    @L["lora.state." + row.Status] (@row.TrainTaskDisplayId)
                                                </MudLink>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2"
                                                         Color="@StatusColor(row.Status)">
                                                    @L["lora.state." + row.Status]
                                                </MudText>
                                            }
                                        </td>
                                        <td style="width: 96px; text-align: right;">
                                            @if (row.Status == LoraModelStates.Training)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small"
                                                               data-lora-model-stop="@row.ModelDisplayId"
                                                               title="@L["lora.model.stop"]"
                                                               OnClick="@(() => StopAsync(row))" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.ModelTraining"
                                                               Size="Size.Small" Color="Color.Primary"
                                                               data-lora-model-train="@row.ModelDisplayId"
                                                               title="@L["lora.model.train"]"
                                                               Disabled="@(!row.LoraSupported)"
                                                               OnClick="@(() => TrainAsync(row))" />
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                           data-lora-model-del="@row.ModelDisplayId"
                                                           title="@L["common.delete"]"
                                                           OnClick="@(() => DeleteModelAsync(row))" />
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
        @* «Применить», а не «Сохранить»: кадры и обучения уже сохранены каждый своим
           действием, а описание уедет в форму объекта — сохранит его она *@
        <MudButton Color="Color.Primary" Variant="Variant.Filled" data-lora-ok="1"
                   OnClick="@(() => Dialog.Close(DialogResult.Ok(_description)))">
            @L["lora.apply"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Объект-адаптер, чья это настройка. Обязан быть СОХРАНЁННЫМ: у кадров и строк
    /// обучения есть владелец, и завести их у ещё не существующего объекта нечему.</summary>
    [Parameter, EditorRequired] public ObjectItem Item { get; set; } = default!;

    /// <summary>Описание объекта на момент открытия: правится здесь, сохраняется формой объекта.</summary>
    [Parameter] public string Description { get; set; } = "";

    private string _description = "";
    private List<ObjectItem>? _frames;
    private List<ObjectLoraModel>? _models;

    /// <summary>Датасеты объекта и выбранный из них (T-274): всё на закладке «Датасет»
    /// относится к выбранному — и кадры, и настройки контроля картинок.</summary>
    private List<LoraDatasetDto>? _datasets;
    private string _datasetId = "";

    /// <summary>Настройки контроля картинок ВЫБРАННОГО датасета — снимок, который правит
    /// форма: пока не нажали «сохранить», в записи лежит прежнее.</summary>
    private LoraDatasetLimitsDto _limits = new();

    /// <summary>Модели закладки «Модели», из которых есть что подставить в настройки.</summary>
    private List<LoraModelLimitsDto>? _modelLimits;

    private CancellationTokenSource? _poll;

    protected override async Task OnInitializedAsync()
    {
        _description = Description;
        // ДАТАСЕТ ЕСТЬ ВСЕГДА (T-274): «при вводе и редактировании автоматически создавать
        // дочерний объект типа датасет». Заводится он здесь, при открытии редактора, а не
        // при первом кадре, — иначе первый же кадр уходил бы неизвестно куда
        try
        {
            await Api.EnsureLoraDatasetAsync(Item.Id);
        }
        catch (ApiException ex)
        {
            // редактор открывают и на чужом сервере, где объект только читают: не дать
            // посмотреть датасет из-за того, что не завёлся новый, было бы хуже
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        await ReloadAsync();
    }

    /// <summary>Датасеты и настройки выбранного. Зовётся и после заведения датасета,
    /// и после правки настроек: список показывает число кадров, а оно меняется.</summary>
    private async Task LoadDatasetsAsync()
    {
        try
        {
            _datasets = await Api.GetLoraDatasetsAsync(Item.Id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _datasets = [];
        }
        var current = _datasets.FirstOrDefault(d => d.Id == _datasetId)
                      ?? _datasets.FirstOrDefault(d => d.IsCurrent)
                      ?? _datasets.FirstOrDefault();
        _datasetId = current?.Id ?? "";
        // правится СНИМОК: иначе «отмена» в форме была бы уже применена к списку
        _limits = Copy(current?.Limits ?? new LoraDatasetLimitsDto());
    }

    private static LoraDatasetLimitsDto Copy(LoraDatasetLimitsDto from) => new()
    {
        MaxWidth = from.MaxWidth,
        MaxHeight = from.MaxHeight,
        MaxKb = from.MaxKb,
        Format = from.Format,
        MinItems = from.MinItems,
        MaxItems = from.MaxItems,
    };

    /// <summary>Подпись выбранного датасета: у MudSelect в поле иначе стоит идентификатор.</summary>
    private string NameOfDataset(string id) =>
        _datasets?.FirstOrDefault(d => d.Id == id) is { } set ? $"{set.Name} ({set.Frames})" : "";

    /// <summary>Сменить текущий датасет: выбор запоминается у объекта — в него лягут новые
    /// кадры и по нему пойдёт обучение, в том числе и не из этой формы.</summary>
    private async Task PickDatasetAsync(string id)
    {
        if (id.Length == 0 || id == _datasetId)
        {
            return;
        }
        _datasetId = id;
        try
        {
            await Api.SetCurrentLoraDatasetAsync(Item.Id, id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    /// <summary>Завести датасет: имя спрашиваем — их у объекта несколько, и «датасет 2»
    /// через месяц не скажет ничего.</summary>
    private async Task AddDatasetAsync()
    {
        var parameters = new DialogParameters<TextPromptDialog>
        {
            { d => d.Label, L["lora.dataset.name"] },
            { d => d.Hint, L["lora.dataset.name.hint"] },
        };
        var dialog = await Dialogs.ShowAsync<TextPromptDialog>(L["lora.dataset.add"], parameters,
            FormDialogs.Options(MaxWidth.ExtraSmall));
        if (await dialog.Result is not { Canceled: false, Data: string name })
        {
            return;
        }
        try
        {
            var created = await Api.CreateLoraDatasetAsync(Item.Id, name.Trim());
            _datasetId = created.Id;
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Подставить настройки из модели: PNG выбирается сам, если модель его называет.</summary>
    private void TakeFromModel(LoraModelLimitsDto model)
    {
        _limits = Copy(model.Limits);
        Snackbar.Add(string.Format(L["lora.limits.taken"], model.ModelName), Severity.Info);
    }

    private async Task SaveLimitsAsync()
    {
        if (_datasetId.Length == 0)
        {
            return;
        }
        try
        {
            await Api.SaveLoraDatasetLimitsAsync(_datasetId, _limits);
            await LoadDatasetsAsync();
            Snackbar.Add(L["common.saved"], Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>
    /// Обучение идёт часами и меняет состояние САМО, без участия человека, — поэтому пока
    /// в списке есть обучающаяся строка, форма перечитывает его сама. Опрос заводится ровно
    /// на это время: список, который дёргает сервер вечно, — это списанный впустую канал.
    /// </summary>
    private void EnsurePolling()
    {
        var needed = _models?.Any(m => m.Status == LoraModelStates.Training) == true;
        if (!needed)
        {
            _poll?.Cancel();
            _poll = null;
            return;
        }
        if (_poll is not null)
        {
            return;
        }
        _poll = new CancellationTokenSource();
        var token = _poll.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    await Task.Delay(TimeSpan.FromSeconds(5), token);
                    await InvokeAsync(async () =>
                    {
                        await LoadModelsAsync();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // окно закрыли — опрос просто кончается, это не ошибка
            }
        }, token);
    }

    private async Task ReloadAsync()
    {
        await LoadDatasetsAsync();
        try
        {
            _frames = await Api.GetLoraDatasetAsync(Item.Id, _datasetId);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _frames = [];
        }
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        try
        {
            _models = await Api.GetLoraModelsAsync(Item.Id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _models = [];
        }
        try
        {
            // список для кнопки «подставить из модели» читается вместе с моделями: он и
            // состоит из них — из тех, у кого в справочнике заполнены настройки картинок
            _modelLimits = await Api.GetLoraModelLimitsAsync(Item.Id);
        }
        catch (ApiException)
        {
            _modelLimits = [];
        }
        EnsurePolling();
    }

    /// <summary>Справка по редактору (T-273): страница поставляемой документации в окне
