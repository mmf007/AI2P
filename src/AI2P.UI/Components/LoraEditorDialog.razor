    private string FrameUrl(ObjectItem frame) => FrameUrlOf(frame.PathOrUrl);

    private static Color StatusColor(string status) => status switch
    {
        LoraModelStates.Ready => Color.Success,
        LoraModelStates.Training => Color.Info,
        LoraModelStates.Error => Color.Error,
        _ => Color.Default,
    };

    // --- датасет ---

    /// <summary>Пределы кадра для формы добавления: она сжимает картинку холстом браузера,
    /// и берёт их у ДАТАСЕТА (T-274), а не у приложения.</summary>
    private LoraImageLimitsDto FrameLimits => new()
    {
        MaxWidth = _limits.MaxWidth,
        MaxHeight = _limits.MaxHeight,
        MaxKb = _limits.MaxKb,
        Format = _limits.Format,
    };

