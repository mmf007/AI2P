@inject I18nService L
@inject IJSRuntime Js
@inject ISnackbar Snackbar

@* ССЫЛКИ НА ОБЪЕКТ (T-99-S0) — их ДВЕ, и они про разное, поэтому и полей два.

   1. Ссылка ДЛЯ ЗАДАЧИ — «@obj:OBJ-3» (T-259). Это не адрес: при запуске задания она
      раскрывается в паспорт объекта и пути его эталонных файлов, и живёт она внутри
      описания задачи. Ниже неё показан текст подстановки — паспорт проверяют ДО генерации.
   2. Ссылка-АДРЕС — «…/object/{id}». Её пересылают людям: она открывает закладку объекта,
      работает на любом сервере кластера (объекты реплицируются) и не зависит от того,
      какой проект у читателя выбран, — объект адресуется своим uuid.

   Типов адреса, как и у задачи, ТРИ (T-207-S0): краткая ссылка от корня сайта, полная
   внутренняя (петлевая) и полная публичная — по имени сервера из настроек. Собирает
   строки общий с окном задачи LinkRows.Build. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudTextField T="string" Value="@Marker" Label="@L["objects.link"]"
                              HelperText="@L["objects.link.hint"]" ReadOnly="true"
                              Margin="Margin.Dense" Class="flex-grow-1" data-object-link-marker="1" />
                <MudTooltip Text="@L["common.copy"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary"
                                   OnClick="@(() => CopyAsync(Marker))" />
                </MudTooltip>
            </MudStack>
            @foreach (var row in Rows())
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudTextField T="string" Value="@row.Url" Label="@row.Label" HelperText="@row.Hint"
                                  ReadOnly="true" Margin="Margin.Dense" Class="flex-grow-1"
                                  data-object-link-url="@row.Key" />
                    <MudTooltip Text="@L["common.copy"]">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary"
                                       OnClick="@(() => CopyAsync(row.Url))" />
                    </MudTooltip>
                </MudStack>
            }
            @if (Prompt.Length > 0)
            {
                <MudTextField T="string" Value="@Prompt" Label="@L["objects.prompt"]"
                              HelperText="@L["objects.prompt.hint"]" ReadOnly="true"
                              Lines="@PromptLines" Variant="Variant.Outlined" Margin="Margin.Dense"
                              data-object-link-prompt="1" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Close())">@L["common.close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Ссылка для вставки в описание задачи: <c>@obj:OBJ-3</c>.</summary>
    [Parameter] public string Marker { get; set; } = "";

    /// <summary>Полный ПУБЛИЧНЫЙ адрес закладки объекта (по имени сервера из настроек).</summary>
    [Parameter] public string Url { get; set; } = "";

    /// <summary>Полный ВНУТРЕННИЙ (петлевой) адрес; пусто — показывается один полный.</summary>
    [Parameter] public string LocalUrl { get; set; } = "";

    /// <summary>Текст подстановки (что уйдёт в модель); пусто — не показывается.</summary>
    [Parameter] public string Prompt { get; set; } = "";

    /// <summary>КРАТКАЯ ссылка (T-196-S0) — от корня сайта, начинается с «/».</summary>
    [Parameter] public string RelativeUrl { get; set; } = "";

    private List<LinkRow> Rows() => LinkRows.Build(L, Url, LocalUrl, RelativeUrl);

    private int PromptLines => Math.Clamp(Prompt.Split('\n').Length + 1, 3, 16);

    private async Task CopyAsync(string text)
    {
        await Js.InvokeVoidAsync("ai2p.copyText", text);
        Snackbar.Add(L["common.copied"], Severity.Success);
    }
}
