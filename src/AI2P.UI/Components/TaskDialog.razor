@inject UiState State
@inject I18nService L
@inject ApiClient Api
@inject ISnackbar Snackbar

@* Форма ввода задачи (ТЗ гл. 11): секции «Основное» и «Расширенное» выделены рамкой;
   описание — редактор Markdown со вставкой картинок из буфера; в «Расширенном» —
   плановая длительность в часах (п. 2.1). В новые задачи подставляются только
   активные проект/команда/исполнители (пп. 2.2, 2.7, 2.8). *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @* СЕКЦИИ (T-300): подписи жирные, рамка толще в полтора раза — класс
               ai2p-section, правило в MainLayout *@
            <MudPaper Outlined="true" Elevation="0" Class="pa-4 ai2p-section">
                <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight: 700;">@L["task.form.main"]</MudText>
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_task.Title" Label="@L["task.title"]" />
                    <MarkdownEditor @bind-Value="_description" Label="@L["task.description"]"
                                    ProjectId="@_task.ProjectId" Rows="8" />
                    @* skills переехали в секцию «оптимизация» (T-23-S0): они не про суть
                       задачи, а про то, кому её отдать и какой опыт подставить в промпт.
                       Кнопки автоподбора остались здесь, рядом с полем исполнителя *@
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @* ToStringFunc — багфикс todo34_3: без него при программной установке
                           значения (автоподбор) в поле показывался id вместо ника *@
                        @* data-task-executor (T-250) — метка для живых проверок: от выбора
                           здесь зависит, есть ли в форме «статус по готовности» *@
                        <MudSelect T="string" @bind-Value="_executorId" Label="@L["task.executor"]"
                                   Clearable="true" Class="flex-grow-1"
                                   data-task-executor="1"
                                   ToStringFunc="@ExecutorNick">
                            @foreach (var executor in AvailableExecutors)
                            {
                                <MudSelectItem T="string" Value="@executor.Id">@executor.Nick</MudSelectItem>
                            }
                        </MudSelect>
                        @if (_skillIds.Any())
                        {
                            @* автоподбор исполнителя по skills (ТЗ v1.26): учитывает
                               «цена ↔ качество» проекта *@
                            <MudTooltip Text="@L["task.pick.aiFirst"]">
                                <MudIconButton Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary"
                                               Disabled="@_picking"
                                               OnClick="@(() => PickExecutorAsync("ai_first"))" />
                            </MudTooltip>
                            <MudTooltip Text="@L["task.pick.humanFirst"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Primary"
                                               Disabled="@_picking"
                                               OnClick="@(() => PickExecutorAsync("human_first"))" />
                            </MudTooltip>
                        }
                    </MudStack>
                    @* «могут заменить исполнителя» (T-221): если в момент запуска основной
                       исполнитель занят, задачу берёт первый свободный отсюда — и запуском
                       вручную, и любым автоматическим (иерархия, разбиение, отложенный старт) *@
                    <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_altExecutorIds"
                               Label="@L["task.altExecutors"]" Clearable="true"
                               HelperText="@L["task.altExecutors.hint"]"
                               MultiSelectionTextFunc="@AltExecutorNames"
                               data-task-alt-executors="1">
                        @foreach (var executor in AvailableExecutors.Where(e => e.Id != _executorId))
                        {
                            <MudSelectItem T="string" Value="@executor.Id">@executor.Nick</MudSelectItem>
                        }
                    </MudSelect>
                    @* СУФЛЁР ЗАДАЧИ (T-292-S0): исполнитель, который по описанию задачи
                       готовит управляющий json для медиа-модели основного исполнителя.
                       Пусто — берётся суфлёр, названный у самого исполнителя; нет и там —
                       запуск такой задачи останавливается ошибкой.
                       Поля видны, только если суфлёр нужен модели исполнителя (T-335-S0) *@
                    @if (PrompterNeeded)
                    {
                    <MudSelect T="string" @bind-Value="_prompterExecutorId" Label="@L["task.prompter"]"
                               Clearable="true" HelperText="@L["task.prompter.hint"]"
                               data-task-prompter="1"
                               ToStringFunc="@ExecutorNick">
                        @foreach (var executor in AvailableExecutors.Where(e => e.Id != _executorId))
                        {
                            <MudSelectItem T="string" Value="@executor.Id">@executor.Nick</MudSelectItem>
                        }
                    </MudSelect>
                    @* «могут заменить суфлёра» (T-292-S0): назначенный суфлёр занят — json
                       готовит первый свободный отсюда; заняты все — задача ждёт на паузе *@
                    <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_prompterAltExecutorIds"
                               Label="@L["task.prompterAlt"]" Clearable="true"
                               HelperText="@L["task.prompterAlt.hint"]"
                               MultiSelectionTextFunc="@AltExecutorNames"
                               data-task-prompter-alt="1">
                        @foreach (var executor in AvailableExecutors.Where(e =>
                            e.Id != _executorId && e.Id != _prompterExecutorId))
                        {
                            <MudSelectItem T="string" Value="@executor.Id">@executor.Nick</MudSelectItem>
                        }
                    </MudSelect>
                    }
                    @* ОТВЕТСТВЕННЫЙ переехал в «Основное» (T-23-S0): это тот, кто отвечает
                       за результат, — вопрос того же ряда, что исполнитель, и прятать его
                       в свёрнутый раздел незачем. У новой задачи подставляется умолчание
                       проекта (T-5-S0) — ник вместо id показывает ToStringFunc, потому что
                       значение ставится программно (наука todo34_3) *@
                    <MudSelect T="string" @bind-Value="_task.ResponsibleId" Label="@L["task.responsible"]"
                               Clearable="true" data-task-responsible="1"
                               ToStringFunc="@ExecutorNick">
                        @foreach (var human in AvailableExecutors.Where(e => e.Kind == ExecutorKind.Human))
                        {
                            <MudSelectItem T="string" Value="@human.Id">@human.Nick</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            </MudPaper>

            <MudPaper Outlined="true" Elevation="0" Class="ai2p-section">
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="@L["task.form.extended"]" Expanded="false">
                        <MudStack Spacing="3">
                            @* активные состояния справочника по порядковому номеру (ТЗ v1.37) *@
                            <MudSelect T="string" @bind-Value="_task.Status" Label="@L["task.status"]"
                                       ToStringFunc="@(id => id is null ? "" : State.StatusName(id))">
                                @foreach (var status in State.TaskStatuses.Where(s => s.IsActive || s.Id == _task.Status))
                                {
                                    <MudSelectItem T="string" Value="@status.Id">@status.Name</MudSelectItem>
                                }
                            </MudSelect>
                            @* СТАТУС ПО ГОТОВНОСТИ (T-250): в него ИИ-агент переводит задачу,
                               нормально её завершив. По умолчанию «проверка» — результат
                               смотрит человек; «готово» означает «проверять нечего», и тогда
                               завершение задачи само отпускает задачи, которые она блокировала.
                               Поле есть только у задачи с исполнителем-ИИ (основным или
                               запасным): завершение задачи человеком его не читает *@
                            @if (HasAiExecutor)
                            {
                                <MudSelect T="string" @bind-Value="_task.AiDoneStatus"
                                           Label="@L["task.aiDoneStatus"]"
                                           HelperText="@L["task.aiDoneStatus.hint"]"
                                           data-task-ai-done-status="1"
                                           ToStringFunc="@(id => id is null ? "" : State.StatusName(id))">
                                    @foreach (var status in State.TaskStatuses
                                        .Where(s => s.IsActive || s.Id == _task.AiDoneStatus))
                                    {
                                        <MudSelectItem T="string" Value="@status.Id">@status.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            @* приоритет: уровень + числовой в одной строке (ТЗ v1.26);
                               смена уровня подставляет 5/15/25, правка числа меняет уровень *@
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudSelect T="int" Value="@_task.Priority" ValueChanged="OnPriorityLevelChanged"
                                           Label="@L["task.priority"]" Class="flex-grow-1">
                                    <MudSelectItem T="int" Value="0">@L["task.priority.0"]</MudSelectItem>
                                    <MudSelectItem T="int" Value="1">@L["task.priority.1"]</MudSelectItem>
                                    <MudSelectItem T="int" Value="2">@L["task.priority.2"]</MudSelectItem>
                                </MudSelect>
                                <MudTooltip Text="@L["task.priorityNum.hint"]">
                                    <MudNumericField T="int" Value="@_task.PriorityNum"
                                                     ValueChanged="OnPriorityNumChanged"
                                                     Label="@L["task.priorityNum"]" Min="0"
                                                     Style="width: 140px;" />
                                </MudTooltip>
                            </MudStack>
                            <MudDatePicker @bind-Date="_dueDate" Label="@L["task.dueDate"]" Clearable="true" />
                            <MudNumericField T="double?" @bind-Value="_task.PlannedHours"
                                             Label="@L["task.plannedHours"]" Min="0" Step="0.5" Clearable="true" />
                            @* смена проекта перечитывает кандидатов в блокирующие (T-248):
                               они берутся из ПРОЕКТА задачи, а проект правится здесь же *@
                            <MudSelect T="string" Value="@_task.ProjectId" ValueChanged="OnProjectChangedAsync"
                                       Label="@L["task.project"]" Clearable="true">
                                @foreach (var project in State.Projects.Where(p => p.IsActive || p.Id == _task.ProjectId))
                                {
                                    <MudSelectItem T="string" Value="@project.Id">@project.Name</MudSelectItem>
                                }
                            </MudSelect>
                            @* команды (T-63-S0): предлагаются только годные ПРОЕКТУ задачи —
                               общие (без проекта) и привязанные к этому же проекту. Уже
                               стоящая в задаче команда показывается всегда, даже чужая:
                               иначе поле правки молча показывало бы пусто *@
                            <MudSelect T="string" @bind-Value="_task.TeamId" Label="@L["task.team"]" Clearable="true">
                                @foreach (var team in State.Teams.Where(t => TeamFits(t.Id, _task.ProjectId) || t.Id == _task.TeamId))
                                {
                                    <MudSelectItem T="string" Value="@team.Id">@team.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_launchMode" Label="@L["task.launch"]">
                                <MudSelectItem T="string" Value="@("manual")">@L["task.launch.manual"]</MudSelectItem>
                                <MudSelectItem T="string" Value="@("auto")">@L["task.launch.auto"]</MudSelectItem>
                                <MudSelectItem T="string" Value="@("schedule")">@L["task.launch.schedule"]</MudSelectItem>
                            </MudSelect>
                            @* ТИП ЗАДАЧИ (T-298-S0): линейная / условие / «цикл до» / «цикл после».
                               Хранится ключами launch_json (TaskFlow), по выбранному типу
                               показываются ровно его поля; у линейной — ничего нового.
                               Ветви условия выбираются ТОЛЬКО из прямых потомков задачи *@
                            <MudStack Spacing="2" data-task-flow="@_flow.Type">
                                <MudSelect T="string" Value="@_flow.Type" ValueChanged="OnFlowTypeChanged"
                                           Label="@L["task.flow"]" HelperText="@L["task.flow.hint"]"
                                           data-task-flow-type="1">
                                    @foreach (var type in TaskFlow.Types)
                                    {
                                        <MudSelectItem T="string" Value="@type">@L["task.flow." + type]</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (_flow.Type == TaskFlow.If)
                                {
                                    @if (_flowChildren.Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" data-task-flow-nochildren="1">@L["task.flow.if.noChildren"]</MudText>
                                    }
                                    @foreach (var yes in new[] { true, false })
                                    {
                                        var isTrue = yes;
                                        var branch = isTrue ? "true" : "false";
                                        var chosen = isTrue ? _flow.IfTrueTaskId : _flow.IfFalseTaskId;
                                        var create = isTrue ? _flow.IfTrueCreateTasks : _flow.IfFalseCreateTasks;
                                        var stop = isTrue ? _flow.IfTrueStopHierarchy : _flow.IfFalseStopHierarchy;
                                        <MudStack Spacing="1" Class="pl-4" data-task-flow-branch="@branch">
                                            <MudSelect T="string" Value="@chosen" Clearable="true"
                                                       ValueChanged="@(v => SetBranchTask(isTrue, v))"
                                                       Label="@L[isTrue ? "task.flow.if.true" : "task.flow.if.false"]"
                                                       ToStringFunc="@FlowChildName"
                                                       data-task-flow-branch-task="@branch">
                                                @foreach (var child in _flowChildren)
                                                {
                                                    <MudSelectItem T="string" Value="@child.Id">@child.DisplayId @child.Title</MudSelectItem>
                                                }
                                            </MudSelect>
                                            @if (chosen is not { Length: > 0 })
                                            {
                                                <MudCheckBox T="bool" Value="@create"
                                                             ValueChanged="@(v => SetBranchCreate(isTrue, v))"
                                                             Label="@L["task.flow.if.create"]"
                                                             data-task-flow-branch-create="@branch" />
                                                @if (!create)
                                                {
                                                    <MudCheckBox T="bool" Value="@stop"
                                                                 ValueChanged="@(v => SetBranchStop(isTrue, v))"
                                                                 Label="@L["task.flow.if.stop"]"
                                                                 data-task-flow-branch-stop="@branch" />
                                                }
                                            }
                                        </MudStack>
                                    }
                                }
                                else if (TaskFlow.IsLoop(_flow.Type))
                                {
                                    <MudNumericField T="int?" @bind-Value="_flow.RecheckLimit" Min="1" Max="100"
                                                     Label="@L["task.flow.loop.limit"]"
                                                     HelperText="@L["task.flow.loop.limit.hint"]"
                                                     data-task-flow-limit="1" />
                                    <MudCheckBox T="bool" @bind-Value="_flow.LoopStopHierarchy"
                                                 Label="@L["task.flow.loop.stop"]"
                                                 data-task-flow-loop-stop="1" />
                                }
                            </MudStack>
                            @* блокирующие задачи (ТЗ v1.35): без их завершения автозапуск
                               не срабатывает; у шаблона список указывает на узлы шаблонов
                               и при копировании заменяется на созданные из них задачи.
                               Список кандидатов (T-248): задачи ПРОЕКТА задачи, кроме
                               завершённых и отменённых, по номеру задачи; рядом — один
                               поиск на заголовок и описание (описание ищет сервер: в
                               браузере его нет, оно лежит файлом .md).
                               Поле рисуется ТОЛЬКО после загрузки кандидатов (_blockersLoaded):
                               подпись выбранного MudSelect считает при ПЕРВОЙ отрисовке и
                               больше не пересчитывает — нарисованный раньше ответа сервера,
                               он навсегда показывал бы GUID вместо кода задачи *@
                            @if (_blockersLoaded)
                            {
                            @* РАЗМЕЩЕНИЕ (T-300): поиск стоит НАД списком блокирующих,
                               отдельной строкой с небольшим отступом слева — сначала
                               ищем, потом выбираем найденное; в одной строке оба поля
                               сжимались на узком экране *@
                            <MudStack Spacing="2">
                                <MudTextField T="string" @bind-Value="_blockerSearch" Immediate="true"
                                              Label="@L["common.search"]"
                                              Placeholder="@L["tasks.search.placeholder"]"
                                              Class="pl-4" Clearable="true"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              OnAdornmentClick="ReloadBlockersAsync"
                                              OnKeyDown="OnBlockerSearchKeyDown"
                                              OnClearButtonClick="ReloadBlockersAsync"
                                              data-blocker-search="1" />
                                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_blockerIds"
                                           Label="@L["task.blockers"]" Clearable="true"
                                           HelperText="@L["task.blockers.hint"]"
                                           MultiSelectionTextFunc="@BlockerNames"
                                           data-task-blockers="1">
                                    @foreach (var candidate in BlockerOptions)
                                    {
                                        <MudSelectItem T="string" Value="@candidate.Id">@candidate.DisplayId @candidate.Title</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>
                            }
                            else
                            {
                                <MudProgressLinear Indeterminate="true" Class="my-2" />
                            }
                            @* ТЭГИ переехали в секцию «оптимизация» (T-23-S0): ими размечена
                               тема работы, и по ним отбирается опыт, подставляемый в промпт *@
                            @* ССЫЛКА ИМПОРТА (T-246): проставляется сама при импорте задачи,
                               здесь её можно поправить или очистить. Заполнена — кнопка
                               «обновить» карточки переспрашивает, обновлять из источника
                               или просто перечитать задачу *@
                            <MudTextField T="string" @bind-Value="_importUrl" Clearable="true"
                                          Label="@L["task.importUrl"]"
                                          HelperText="@L["task.importUrl.hint"]"
                                          data-task-import-url="1" />
                            <MarkdownEditor @bind-Value="_acceptance" Label="@L["task.acceptance"]"
                                            ProjectId="@_task.ProjectId" Rows="3" MinHeightPx="80" />
                            @* «не разбивать на подзадачи» (ТЗ v1.26): ставится автоматически
                               после авторазбиения, можно управлять вручную *@
                            <MudSwitch T="bool" @bind-Value="_task.IsNotSplit" Label="@L["task.isNotSplit"]"
                                       Color="Color.Primary" />
                            <MudSwitch T="bool" @bind-Value="_task.IsTemplate" Label="@L["task.isTemplate"]"
                                       Color="Color.Primary" />
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>

            @* СЕКЦИЯ «ОПТИМИЗАЦИЯ» (T-23-S0) — всё, что решает не «что сделать», а «сколько
               работы получит агент и сколько её сделает»: навыки и тэги (по ним отбираются
               исполнитель и записи опыта), две галочки про блоки промпта и «время ↔ качество».
               Отдельной секцией, а не в «Расширенном», потому что настраивают её осознанно
               и все четыре поля разом *@
            <MudPaper Outlined="true" Elevation="0" Class="ai2p-section">
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="@L["task.form.optimization"]" Expanded="false">
                        <MudStack Spacing="3" data-task-optimization="1">
                            @* skills — что по факту надо сделать (ТЗ v1.26); обычно одно значение,
                               поле необязательное; по нему работает автоподбор исполнителя
                               и отбор записей опыта *@
                            <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_skillIds"
                                       Label="@L["task.skills"]" Clearable="true"
                                       data-task-skills="1"
                                       MultiSelectionTextFunc="@SkillNames">
                                @foreach (var skill in State.Skills)
                                {
                                    <MudSelectItem T="string" Value="@skill.Id">@SkillLabel(skill)</MudSelectItem>
                                }
                            </MudSelect>
                            @* ТЭГИ — ключевые слова задачи (T-222). Поле множественного
                               выбора из уже заведённых тэгов организации плюс ввод нового:
                               справочника у тэгов нет намеренно, тэг заводится тем, что его
                               здесь написали. Запятая — разделитель, «ui, сборка» даёт два тэга *@
                            @* РАЗМЕЩЕНИЕ (T-300): ввод нового тэга стоит НАД списком тэгов,
                               отдельной строкой с небольшим отступом слева, — в одной
                               строке на узком экране телефона список тэгов сжимался
                               до нечитаемого *@
                            <MudStack Spacing="2">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="pl-4">
                                    <MudTextField T="string" @bind-Value="_newTag" Immediate="true"
                                                  Label="@L["task.tags.new"]" Class="flex-grow-1"
                                                  data-tag-new="1" OnKeyDown="OnNewTagKeyDown" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                                   title="@L["task.tags.add"]" data-tag-add="1"
                                                   Disabled="@(_newTag.Trim().Length == 0)" OnClick="AddNewTag" />
                                </MudStack>
                                <MudSelect T="string" MultiSelection="true" SelectedValues="@_tags"
                                           SelectedValuesChanged="OnTagsChanged"
                                           Label="@L["task.tags"]" Clearable="true"
                                           HelperText="@L["task.tags.hint"]"
                                           data-task-tags="1"
                                           MultiSelectionTextFunc="@(list => string.Join(", ", list))">
                                    @foreach (var tag in _allTags)
                                    {
                                        <MudSelectItem T="string" Value="@tag">@tag</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>
                            @* блоки промпта задания (T-23-S0): по умолчанию оба выключены —
                               вместе они весят до 60 000 знаков, а нужны далеко не каждой
                               задаче; выключенный блок агент при надобности прочитает сам *@
                            <MudSwitch T="bool" @bind-Value="_task.ParentInPrompt"
                                       Label="@L["task.parentInPrompt"]"
                                       data-task-parent-in-prompt="1" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Style="opacity:.7;">@L["task.parentInPrompt.hint"]</MudText>
                            <MudSwitch T="bool" @bind-Value="_task.SiblingsInPrompt"
                                       Label="@L["task.siblingsInPrompt"]"
                                       data-task-siblings-in-prompt="1" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Style="opacity:.7;">@L["task.siblingsInPrompt.hint"]</MudText>
                            @* ВРЕМЯ ↔ КАЧЕСТВО (T-23-S0): у новой задачи подставляется
                               умолчание проекта, дальше это выбор человека *@
                            <div data-task-timequality="1">
                                <MudText Typo="Typo.caption">@L["task.timeQuality"]: @_timeQuality.ToString("0.00")</MudText>
                                <MudSlider T="double" @bind-Value="_timeQuality" Min="0" Max="1" Step="0.05"
                                           Color="Color.Primary" />
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.caption" Style="opacity:.7;">@L["task.timeQuality.time"]</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:.7;">@L["task.timeQuality.quality"]</MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption" Style="opacity:.7;">@L["task.timeQuality.hint"]</MudText>
                            </div>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_task.Title.Trim().Length == 0)" OnClick="Save">@L["common.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>null — новая задача; иначе — редактирование.</summary>
    [Parameter] public TaskDetailsDto? Source { get; set; }

    /// <summary>true — форма открывается для создания шаблона (список шаблонов, гл. 5).</summary>
    [Parameter] public bool AsTemplate { get; set; }

    /// <summary>Родительская задача — при создании подзадачи из карточки задачи (гл. 11):
    /// новая задача получает родителя и его проект/команду.</summary>
    [Parameter] public TaskItem? Parent { get; set; }

    /// <summary>Проект новой задачи вместо текущего — вкладка «задачи» проекта (ТЗ v1.17).</summary>
    [Parameter] public string? PresetProjectId { get; set; }

    /// <summary>Команда новой задачи вместо текущей — вкладка «задачи» проекта (ТЗ v1.17).</summary>
    [Parameter] public string? PresetTeamId { get; set; }

    /// <summary>Содержимое импортированной карточки (ТЗ v1.50, todo50): заголовок, описание
    /// со ссылками на скачанные файлы, срок и external_ref подставляются в форму новой задачи.</summary>
    [Parameter] public ImportedCardDto? Preset { get; set; }

    private TaskItem _task = new();
    private string _description = "";
    private string _acceptance = "";
    private string? _executorId;
    private string _launchMode = "manual";
    private DateTime? _dueDate;
    private IReadOnlyCollection<string> _skillIds = [];
    /// <summary>«Могут заменить исполнителя» (T-221) — запасные на случай занятого основного.</summary>
    private IReadOnlyCollection<string> _altExecutorIds = [];
    /// <summary>Суфлёр задачи и те, кто могут его заменить (T-292-S0).</summary>
    private string? _prompterExecutorId;
    private IReadOnlyCollection<string> _prompterAltExecutorIds = [];
    private IReadOnlyCollection<string> _blockerIds = [];

    /// <summary>Тип задачи и его параметры (T-298-S0): правятся здесь, в launch_json уходят
    /// при сохранении (<see cref="TaskFlow.Write"/>), прочие ключи launch_json не трогаются.</summary>
    private TaskFlowDto _flow = new();

    /// <summary>ПРЯМЫЕ потомки задачи (T-298-S0) — единственные кандидаты в задачи ветвей
    /// условия. У новой задачи потомков нет: ветви заводятся правкой.</summary>
    private List<TaskItem> _flowChildren = [];

    /// <summary>Подпись выбранной задачи ветви — код и заголовок вместо id.</summary>
    private string FlowChildName(string? id) =>
        id is null ? "" : _flowChildren.FirstOrDefault(c => c.Id == id) is { } child
            ? $"{child.DisplayId} {child.Title}" : id;

    /// <summary>Смена типа: лимит цикла подставляется из настроек проекта (T-298-S0), если
    /// его ещё нет, — человек видит ровно то, с чем задача пойдёт.</summary>
    private void OnFlowTypeChanged(string type)
    {
        _flow.Type = TaskFlow.Normalize(type);
        if (TaskFlow.IsLoop(_flow.Type) && _flow.RecheckLimit is null)
        {
            _flow.RecheckLimit = ProjectSettings.RecheckLimit(_task.ProjectId is { Length: > 0 }
                ? State.Projects.FirstOrDefault(p => p.Id == _task.ProjectId)?.SettingsJson
                : null);
        }
    }

    private void SetBranchTask(bool yes, string? id)
    {
        if (yes)
        {
            _flow.IfTrueTaskId = id;
        }
        else
        {
            _flow.IfFalseTaskId = id;
        }
    }

    private void SetBranchCreate(bool yes, bool on)
    {
        if (yes)
        {
            _flow.IfTrueCreateTasks = on;
        }
        else
        {
            _flow.IfFalseCreateTasks = on;
        }
    }

    private void SetBranchStop(bool yes, bool on)
    {
        if (yes)
        {
            _flow.IfTrueStopHierarchy = on;
        }
        else
        {
            _flow.IfFalseStopHierarchy = on;
        }
    }

    /// <summary>Прямые потомки задачи для ветвей условия (T-298-S0): задачи её проекта
    /// (у узла шаблона — узлы шаблонов) с этим родителем.</summary>
    /// <param name="known">Уже прочитанный список задач проекта — тот же самый, что нужен
    /// полю блокирующих (T-363-S0). Без него открытие формы делало ДВА одинаковых запроса
    /// подряд, а список задач проекта — самый тяжёлый запрос карточки.</param>
    private async Task LoadFlowChildrenAsync(List<TaskItem>? known = null)
    {
        if (_task.Id.Length == 0)
        {
            return;
        }
        try
        {
            var all = known ?? (_task.IsTemplate
                ? await Api.GetTasksAsync(templatesOnly: true)
                : await Api.GetTasksAsync(projectId: _task.ProjectId));
            _flowChildren = all.Where(t => t.ParentId == _task.Id)
                .OrderBy(t => t.DisplayId, StringComparer.Ordinal).ToList();
        }
        catch (ApiException)
        {
            // без списка форма работает: ветви останутся без задачи
        }
    }

    /// <summary>
    /// «Время ↔ качество» (T-23-S0) отдельным полем, а не прямо в <c>_task</c>: у задачи оно
    /// nullable («не задано — взять умолчание проекта»), а бегунку нужно число. В форме
    /// пустого значения нет намеренно — человек видит ровно ту величину, с которой пойдёт
    /// работа, и сохранение записывает её в задачу явно.
    /// </summary>
    private double _timeQuality = ProjectSettings.TimeQualityDefault;

    /// <summary>Ссылка импорта (T-246): откуда задача приехала. Отдельным полем, а не
    /// прямо в _task, — MudTextField с Clearable даёт при очистке пустую строку либо null,
    /// а в задачу должно уйти одно и то же «пусто».</summary>
    private string? _importUrl;

    /// <summary>Что пришло с сервера последним запросом кандидатов в блокирующие: задачи
    /// проекта задачи, при непустом поиске — только подошедшие ему (T-248).</summary>
    private List<TaskItem> _blockerCandidates = [];

    /// <summary>Все задачи, побывавшие в кандидатах, по идентификатору (T-248). Нужен ровно
    /// для одного: ВЫБРАННАЯ блокирующая обязана остаться пунктом списка, даже если её
    /// отбросил поиск или новый проект — иначе снять выбор нечем, а в поле вместо кода
    /// задачи показался бы GUID.</summary>
    private readonly Dictionary<string, TaskItem> _blockerKnown = new(StringComparer.Ordinal);

    /// <summary>Поиск по кандидатам в блокирующие (T-248): один на заголовок и описание,
    /// выполняет его сервер — описание задачи лежит файлом .md, в браузере его нет.</summary>
    private string _blockerSearch = "";

    /// <summary>Кандидаты в блокирующие прочитаны хотя бы раз (T-248). До этого поле не
    /// рисуется вовсе: <c>MudSelect</c> считает подпись выбранного значения при ПЕРВОЙ
    /// отрисовке и потом не пересчитывает — нарисованный до ответа сервера, он навсегда
    /// показывал бы GUID вместо кода задачи. Флаг ставится и при ошибке запроса: без списка
    /// форма всё равно должна работать.</summary>
    private bool _blockersLoaded;

    private bool _picking;

    /// <summary>Пункты списка блокирующих: отбор и порядок — <see cref="BlockerCandidates"/>.</summary>
    private List<TaskItem> BlockerOptions => BlockerCandidates.Options(
        _blockerCandidates,
        _blockerIds.Select(id => _blockerKnown.GetValueOrDefault(id)).OfType<TaskItem>(),
        _task.Id);

    /// <summary>Выбранные тэги задачи (T-222).</summary>
    private IReadOnlyCollection<string> _tags = [];

    /// <summary>Тэги, предлагаемые в списке: все заведённые в организации плюс те, что уже
    /// стоят у этой задачи (её тэг мог быть снят с остальных задач, пока форма открыта).</summary>
    private List<string> _allTags = [];

    /// <summary>Поле ввода нового тэга — того, которого в списке ещё нет (T-222).</summary>
    private string _newTag = "";

    private void OnTagsChanged(IEnumerable<string> values) => _tags = values.ToList();

    /// <summary>Enter в поле нового тэга добавляет его — как «+»: набирать тэги подряд
    /// удобнее с клавиатуры, а не мышью.</summary>
    private void OnNewTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddNewTag();
        }
    }

    /// <summary>
    /// Добавить введённые тэги: приведение то же, что в хранилище (запятая — разделитель,
    /// пробелы по краям снимаются, повтор без учёта регистра не заводится). Новый тэг
    /// попадает и в список выбора — иначе выбранное значение осталось бы без своего пункта.
    /// </summary>
    private void AddNewTag()
    {
        var added = TaskTags.Normalize(_newTag);
        if (added.Count == 0)
        {
            return;
        }
        var selected = _tags.ToList();
        foreach (var tag in added)
        {
            if (!_allTags.Any(t => TaskTags.Same(t, tag)))
            {
                _allTags.Add(tag);
                _allTags.Sort(StringComparer.CurrentCultureIgnoreCase);
            }
            if (!selected.Any(t => TaskTags.Same(t, tag)))
            {
                selected.Add(tag);
            }
        }
        _tags = selected;
        _newTag = "";
    }

    /// <summary>Выбранные блокирующие задачи в поле — коды вместо id.</summary>
    private string BlockerNames(IReadOnlyList<string> ids) =>
        string.Join(", ", ids.Select(id => _blockerKnown.GetValueOrDefault(id)?.DisplayId ?? id));

    /// <summary>
    /// Кандидаты в блокирующие (ТЗ v1.35, отбор T-248): для шаблона — узлы шаблонов (все,
    /// включая общие: у общего шаблона проекта нет, а в списке он нужен), для задачи —
    /// задачи ЕЁ ПРОЕКТА. Поиск один на заголовок и описание, его делает сервер.
    /// Завершённые и отменённые отсеиваются при отрисовке (<see cref="BlockerOptions"/>):
    /// уже выбранную блокирующую из списка выбрасывать нельзя.
    /// </summary>
    private async Task ReloadBlockersAsync()
    {
        var search = _blockerSearch.Trim().Length == 0 ? null : _blockerSearch.Trim();
        try
        {
            _blockerCandidates = _task.IsTemplate
                ? await Api.GetTasksAsync(templatesOnly: true, search: search)
                : await Api.GetTasksAsync(projectId: _task.ProjectId, search: search);
            foreach (var candidate in _blockerCandidates)
            {
                _blockerKnown[candidate.Id] = candidate;
            }
        }
        catch (ApiException)
        {
            // список кандидатов — вспомогательный: без него форма работает
        }
    }

    /// <summary>
    /// Дотянуть выбранные блокирующие, которых среди кандидатов НЕТ (T-248). Кандидаты —
    /// задачи проекта, а блокирующая могла остаться от ДРУГОГО проекта: проект правится в
    /// этой же форме, и после сохранения такая ссылка вполне законна (хранилище одного
    /// проекта у блокирующих не требует). Без этого у неё не было бы пункта списка — в поле
    /// вместо кода задачи показался бы GUID, а снять её было бы нечем.
    /// </summary>
    private async Task ResolveChosenBlockersAsync()
    {
        foreach (var id in _blockerIds.Where(id => !_blockerKnown.ContainsKey(id)).ToList())
        {
            try
            {
                _blockerKnown[id] = (await Api.GetTaskAsync(id)).Task;
            }
            catch (ApiException)
            {
                // задача могла быть удалена: пункта не будет, но форма работает
            }
        }
    }

    /// <summary>Enter в поле поиска — то же, что нажать лупу (как в списках задач).</summary>
    private Task OnBlockerSearchKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" ? ReloadBlockersAsync() : Task.CompletedTask;

    /// <summary>Проект задачи правится в этой же форме, а кандидаты в блокирующие берутся
    /// из проекта — значит, список надо перечитать (T-248).</summary>
    private async Task OnProjectChangedAsync(string? projectId)
    {
        // ответственный по умолчанию (T-5-S0) идёт за проектом, пока человек не выбрал своего:
        // поле, в котором стоит умолчание ПРЕЖНЕГО проекта (или пусто), получает умолчание
        // нового. Выбор человека при этом не трогается — и в правке задачи не трогается ничего
        var wasDefault = _task.ResponsibleId is null || _task.ResponsibleId == DefaultResponsibleOf(_task.ProjectId);
        // «время ↔ качество» (T-23-S0) переезжает по тому же правилу: значение, оставшееся
        // умолчанием ПРЕЖНЕГО проекта, заменяется умолчанием нового; сдвинутый человеком
        // бегунок не трогается — это уже его выбор
        var timeWasDefault = Math.Abs(_timeQuality - DefaultTimeQualityOf(_task.ProjectId)) < 1e-9;
        _task.ProjectId = projectId;
        if (Source is null && wasDefault)
        {
            _task.ResponsibleId = DefaultResponsibleOf(projectId);
        }
        if (Source is null && timeWasDefault)
        {
            _timeQuality = DefaultTimeQualityOf(projectId);
        }
        if (Source is null)
        {
            // команда идёт за проектом (T-63-S0): чужая проекту команда заменяется командой
            // нового проекта — иначе форма сохранила бы задачу с командой другого проекта
            _task.TeamId = TeamForProject(_task.TeamId, projectId);
        }
        await ReloadBlockersAsync();
    }

    /// <summary>
    /// КОМАНДА ГОДИТСЯ ЗАДАЧЕ ЭТОГО ПРОЕКТА (T-63-S0): она активна (п. 2.8) и либо общая
    /// (проекта у неё нет), либо привязана к этому же проекту (<c>teams.project_id</c>).
    /// Проекта у задачи нет — проверять не по чему, годится любая активная команда.
    /// </summary>
    private bool TeamFits(string? teamId, string? projectId)
    {
        if (teamId is not { Length: > 0 })
        {
            return false;
        }
        var team = State.Teams.FirstOrDefault(t => t.Id == teamId);
        return team is { IsActive: true }
               && (projectId is not { Length: > 0 }
                   || team.ProjectId is not { Length: > 0 }
                   || team.ProjectId == projectId);
    }

    /// <summary>Команда для НОВОЙ задачи проекта (T-63-S0): подставляемая, если она годится
    /// проекту, иначе команда по умолчанию проекта (п. 2.7); не годится и она — пусто.</summary>
    private string? TeamForProject(string? teamId, string? projectId)
    {
        // у задачи БЕЗ проекта подставляется только общая команда (T-335-S0): TeamFits без
        // проекта пропускает любую, и новый шаблон вне проекта цеплял текущую команду
        // другого проекта
        if (TeamFits(teamId, projectId)
            && (projectId is { Length: > 0 }
                || State.Teams.FirstOrDefault(t => t.Id == teamId)?.ProjectId is not { Length: > 0 }))
        {
            return teamId;
        }
        var byProject = projectId is { Length: > 0 }
            ? ProjectSettings.DefaultTeamId(State.Projects.FirstOrDefault(p => p.Id == projectId)?.SettingsJson)
            : null;
        return TeamFits(byProject, projectId) ? byProject : null;
    }

    /// <summary>
    /// ОТВЕТСТВЕННЫЙ ПО УМОЛЧАНИЮ проекта (T-5-S0), годный к подстановке: живой активный
    /// человек. Исполнителя могли выключить или удалить уже после того, как его записали
    /// в настройки проекта, — тогда умолчания просто нет, и поле остаётся пустым (иначе
    /// форма предлагала бы значение, которое хранилище не примет).
    /// </summary>
    private string? DefaultResponsibleOf(string? projectId)
    {
        if (projectId is not { Length: > 0 })
        {
            return null;
        }
        var project = State.Projects.FirstOrDefault(p => p.Id == projectId);
        if (ProjectSettings.DefaultResponsibleId(project?.SettingsJson) is not { } responsibleId)
        {
            return null;
        }
        var executor = State.Executors.FirstOrDefault(e => e.Id == responsibleId);
        return executor is { IsActive: true, Kind: ExecutorKind.Human } ? responsibleId : null;
    }

    /// <summary>
    /// «ВРЕМЯ ↔ КАЧЕСТВО» ПО УМОЛЧАНИЮ (T-23-S0) — из настроек проекта; проекта нет или
    /// настройка не заполнена — <see cref="ProjectSettings.TimeQualityDefault"/> (0,5).
    /// Проверять годность значения, в отличие от ответственного, не надо: это число.
    /// </summary>
    private double DefaultTimeQualityOf(string? projectId) =>
        ProjectSettings.TimeQuality(projectId is { Length: > 0 }
            ? State.Projects.FirstOrDefault(p => p.Id == projectId)?.SettingsJson
            : null);

    protected override async Task OnInitializedAsync()
    {
        await ReloadBlockersAsync();
        await ResolveChosenBlockersAsync();
        _blockersLoaded = true;
        // ветви условия берутся из УЖЕ прочитанного списка задач проекта (T-363-S0):
        // при открытии формы поиска по кандидатам нет, значит список полный
        await LoadFlowChildrenAsync(_blockerSearch.Trim().Length == 0 ? _blockerCandidates : null);
        try
        {
            // тэги организации (T-222): предлагаются в списке выбора; свои тэги задачи
            // добавляются к ним — тэг мог остаться только у неё, и в общем списке его уже нет
            var known = await Api.GetTagsAsync();
            _allTags = known.Concat(_tags).Distinct(StringComparer.CurrentCultureIgnoreCase)
                .OrderBy(t => t, StringComparer.CurrentCultureIgnoreCase).ToList();
        }
        catch (ApiException)
        {
            // без общего списка тэгов форма работает: свои тэги видны, новые вводятся полем
            _allTags = _tags.ToList();
        }
    }

    /// <summary>Отображаемое имя skill: перевод встроенного либо код (ТЗ v1.17).</summary>
    private string SkillLabel(Skill skill) =>
        skill.IsCustom ? skill.Name : L["skill." + skill.Name];

    /// <summary>Выбранные skills в поле — имена вместо id (MultiSelectionTextFunc).</summary>
    private string SkillNames(IReadOnlyList<string> ids) =>
        string.Join(", ", ids.Select(id =>
            State.Skills.FirstOrDefault(s => s.Id == id) is { } skill ? SkillLabel(skill) : id));

    /// <summary>Смена уровня приоритета подставляет типовое число 5/15/25 (ТЗ v1.26).</summary>
    private void OnPriorityLevelChanged(int level)
    {
        _task.Priority = level;
        _task.PriorityNum = TaskPriority.NumFor(level);
    }

    /// <summary>Правка числового приоритета меняет уровень по диапазону (ТЗ v1.26).</summary>
    private void OnPriorityNumChanged(int num)
    {
        _task.PriorityNum = num;
        _task.Priority = TaskPriority.LevelFor(num);
    }

    /// <summary>Автоподбор исполнителя по skills (ТЗ v1.26): сначала ИИ или сначала человек;
    /// алгоритм учитывает «цена ↔ качество» проекта.</summary>
    private async Task PickExecutorAsync(string mode)
    {
        _picking = true;
        try
        {
            var picked = await Api.PickExecutorAsync(_task.ProjectId, _task.TeamId, _skillIds, mode);
            if (picked.ExecutorId is null)
            {
                Snackbar.Add(L["task.pick.notFound"] + ": " + picked.Reason, Severity.Warning);
            }
            else
            {
                _executorId = picked.ExecutorId;
                // СУФЛЁР подбирается заодно (T-292-S0): медиа-модель, которой нужен
                // управляющий json, без него не запустится вовсе
                if (picked.PrompterExecutorId is { Length: > 0 } prompter)
                {
                    _prompterExecutorId = prompter;
                }
                Snackbar.Add($"{L["task.pick.found"]}: {picked.Nick} ({picked.Reason})", Severity.Success);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _picking = false;
        }
    }

    /// <summary>Выбор исполнителя ограничен участниками команды задачи (ТЗ п. 2.1); в новые
    /// задачи подставляются только активные исполнители (п. 2.2).
    ///
    /// «АВТО ПО» ЧУЖОГО СЕРВЕРА В СПИСОК НЕ ПОПАДАЕТ (T-153-S0): программа стоит на своём
    /// компьютере, и задание отсюда запустить нечем — назначать такого исполнителя значит
    /// завести задачу, которая никогда не тронется с места. Уже назначенный остаётся видимым,
    /// иначе форма молча стёрла бы исполнителя чужой задачи при первом же сохранении.</summary>
    private IEnumerable<Executor> AvailableExecutors
    {
        get
        {
            var team = State.Teams.FirstOrDefault(t => t.Id == _task.TeamId);
            var executors = team is null
                ? State.Executors.AsEnumerable()
                : State.Executors.Where(e => team.Members.Any(m => m.ExecutorId == e.Id));
            return executors
                .Where(e => e.Kind != ExecutorKind.Software
                            || e.ServerId == State.ServerId
                            || e.Id == _executorId || _altExecutorIds.Contains(e.Id))
                .Where(e => e.IsActive || e.Id == _executorId || e.Id == _task.ResponsibleId);
        }
    }

    /// <summary>Выбранные запасные исполнители в поле — ники вместо id (T-221).</summary>
    private string AltExecutorNames(IReadOnlyList<string> ids) =>
        string.Join(", ", ids.Select(ExecutorNick));

    /// <summary>
    /// Задача исполняется НЕ ЧЕЛОВЕКОМ (T-250; уточнено в T-153-S0): исполнитель — ИИ или
    /// «авто ПО», основной либо один из тех, кто может его заменить (T-221): задачу вправе
    /// взять любой из них. Только у такой задачи в форме есть «статус по готовности» — его
    /// читает то, что ЗАВЕРШАЕТ задачу само; у задачи человека его никто не читает.
    /// Считается по ТЕКУЩЕМУ выбору в форме, а не по сохранённой задаче, — поменяли
    /// исполнителя, и поле появилось, не закрывая формы.
    /// </summary>
    private bool HasAiExecutor =>
        _altExecutorIds.Concat(_executorId is null ? [] : new[] { _executorId })
            .Any(id => State.Executors.FirstOrDefault(e => e.Id == id) is { } e
                       && e.Kind != ExecutorKind.Human);

    /// <summary>
    /// Нужен ли задаче СУФЛЁР (T-335-S0): хотя бы один из выбранных исполнителей (основной
    /// или заменяющий) — ИИ, чья рабочая модель медийная и просит суфлёра в профайле; то же
    /// условие, что у поля суфлёра в форме исполнителя. Иначе поля суфлёра в форме не видны.
    /// </summary>
    private bool PrompterNeeded =>
        _altExecutorIds.Concat(_executorId is null ? [] : new[] { _executorId })
            .Any(id => State.Executors.FirstOrDefault(e => e.Id == id) is { Kind: ExecutorKind.Ai } e
                       && State.Models.FirstOrDefault(m => m.Id == e.ModelId)
                           is { IsMedia: true, Prompter.Required: true });

    /// <summary>Ник по id для текста поля «исполнитель» (багфикс todo34_3: MudSelect без
    /// ToStringFunc показывал GUID при программной установке значения).</summary>
    private string ExecutorNick(string? id) =>
        id is null ? "" : State.Executors.FirstOrDefault(e => e.Id == id)?.Nick ?? id;

    protected override void OnInitialized()
    {
        if (Source is null)
        {
            // проект и команда — автоматически из текущих по умолчанию (ТЗ п. 2.1);
            // неактивные текущие проект/команда в новую задачу не подставляются (пп. 2.7, 2.8)
            _task = new TaskItem
            {
                ProjectId = Parent is not null
                    ? Parent.ProjectId
                    : PresetProjectId
                      ?? (State.CurrentProject is { IsActive: true } ? State.CurrentProjectId : null),
                // команда: у подзадачи — родительская, иначе пресет формы либо текущая.
                // Годность проекту проверяется ниже (T-63-S0)
                TeamId = Parent is not null
                    ? Parent.TeamId
                    : PresetTeamId
                      ?? (State.CurrentTeam is { IsActive: true } ? State.CurrentTeamId : null),
                ParentId = Parent?.Id,
                Status = TaskStatuses.Pending,
                IsTemplate = AsTemplate || Parent is { IsTemplate: true },
            };
            // команда, чужая проекту задачи, в новую задачу не подставляется (T-63-S0):
            // текущая команда остаётся от прежнего проекта, а команда узла общего шаблона
            // и вовсе принадлежит другому проекту — вместо чужой берётся команда проекта
            // без родителя и пресета формы команда ПРОЕКТА важнее текущей (T-335-S0): форма
            // шаблона вкладки проекта пресета команды не передаёт, и в узел шла текущая
            if (Parent is null && PresetTeamId is null)
            {
                var byProject = TeamForProject(null, _task.ProjectId);
                if (byProject is not null)
                {
                    _task.TeamId = byProject;
                }
            }
            _task.TeamId = TeamForProject(_task.TeamId, _task.ProjectId);
            // ответственный по умолчанию проекта (T-5-S0): подставляется в поле новой задачи,
            // и человек волен тут же его снять — это умолчание, а не обязательство.
            // У УЗЛА ШАБЛОНА поля не заполняем: умолчание проекта подставляется в копию
            // шаблона при её создании, и подставляется по проекту КОПИИ, а не шаблона
            if (!_task.IsTemplate)
            {
                _task.ResponsibleId = DefaultResponsibleOf(_task.ProjectId);
            }
            // «время ↔ качество» (T-23-S0): умолчание проекта подставляется и в узел шаблона —
            // в отличие от ответственного, это не ссылка на живого человека, а число, и
            // расписать его в шаблоне (а не подставлять по проекту копии) вполне осмысленно
            _timeQuality = DefaultTimeQualityOf(_task.ProjectId);
            if (Preset is not null)
            {
                // импорт одиночного задания по URL (ТЗ v1.50): содержимое карточки — в форму;
                // external_ref сохраняется — повторный импорт той же карточки не создаст дубль
                _task.Title = Preset.Title;
                _task.ExternalRef = Preset.ExternalRef;
                _task.Status = TaskStatuses.Draft;
                _description = Preset.Description;
                _dueDate = Preset.DueDate?.ToLocalTime();
                // ссылка импорта (T-246): подставляется сама — по ней задачу потом обновляют
                _importUrl = Preset.ImportUrl;
            }
        }
        else
        {
            var src = Source.Task;
            _task = new TaskItem
            {
                Id = src.Id,
                DisplayId = src.DisplayId,
                ProjectId = src.ProjectId,
                TeamId = src.TeamId,
                ParentId = src.ParentId,
                Kind = src.Kind,
                Title = src.Title,
                Status = src.Status,
                // статус по готовности (T-250): задача уходит на сервер целиком, поэтому нести
                // его надо и тогда, когда поля в форме нет вовсе (исполнитель — человек)
                AiDoneStatus = src.AiDoneStatus,
                // секция «оптимизация» (T-23-S0): галочки правятся здесь же, поэтому просто
                // переносятся в правимый снимок задачи
                ParentInPrompt = src.ParentInPrompt,
                SiblingsInPrompt = src.SiblingsInPrompt,
                Priority = src.Priority,
                PriorityNum = src.PriorityNum,
                IsNotSplit = src.IsNotSplit,
                DueDate = src.DueDate,
                PlannedHours = src.PlannedHours,
                ResponsibleId = src.ResponsibleId,
                LaunchJson = src.LaunchJson,
                IsTemplate = src.IsTemplate,
                TemplateId = src.TemplateId,
                // внешний ключ карточки (ТЗ v1.28) формой не правится, но нести его надо:
                // задача уходит на сервер целиком
                ExternalRef = src.ExternalRef,
            };
            _importUrl = src.ImportUrl;   // ссылка импорта (T-246) — правится и очищается
            _description = Source.Description;
            _acceptance = Source.Acceptance;
            _executorId = src.ExecutorIds.FirstOrDefault();
            _altExecutorIds = src.AltExecutorIds.ToArray();   // могут заменить исполнителя (T-221)
            _prompterExecutorId = src.PrompterExecutorId;     // суфлёр задачи (T-292-S0)
            _prompterAltExecutorIds = src.PrompterAltExecutorIds.ToArray();
            _skillIds = src.SkillIds.ToArray();
            _blockerIds = src.BlockerIds.ToArray();
            _tags = src.Tags.ToArray();   // тэги задачи (T-222)
            _dueDate = src.DueDate?.ToLocalTime();
            _launchMode = ReadLaunchMode(src.LaunchJson);
            _flow = TaskFlow.Read(src.LaunchJson);   // тип задачи (T-298-S0)
            // «время ↔ качество» (T-23-S0): у задачи поле может быть не заполнено (её завели
            // мимо формы) — тогда показываем то, с чем она и так работает, умолчание проекта
            _timeQuality = src.TimeQuality ?? DefaultTimeQualityOf(src.ProjectId);
        }
    }

    private static string WithLaunchMode(string launchJson, string mode)
    {
        System.Text.Json.Nodes.JsonObject root;
        try
        {
            root = System.Text.Json.Nodes.JsonNode.Parse(launchJson)
                as System.Text.Json.Nodes.JsonObject ?? [];
        }
        catch (System.Text.Json.JsonException)
        {
            root = [];
        }
        root["mode"] = mode;
        return root.ToJsonString();
    }

    private static string ReadLaunchMode(string launchJson)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(launchJson);
            return doc.RootElement.TryGetProperty("mode", out var mode) ? mode.GetString() ?? "manual" : "manual";
        }
        catch (System.Text.Json.JsonException)
        {
            return "manual";
        }
    }

    private void Save()
    {
        _task.DueDate = _dueDate?.ToUniversalTime();
        // режим меняется с сохранением прочих полей launch_json (флаги autoSplit и др., ТЗ v1.26)
        _task.LaunchJson = WithLaunchMode(_task.LaunchJson, _launchMode);
        // тип задачи и его параметры (T-298-S0); ветви условия — только из прямых потомков,
        // проверку повторяет хранилище
        if (_flow.IfTrueTaskId is { } trueId && _flowChildren.All(c => c.Id != trueId))
        {
            _flow.IfTrueTaskId = null;
        }
        if (_flow.IfFalseTaskId is { } falseId && _flowChildren.All(c => c.Id != falseId))
        {
            _flow.IfFalseTaskId = null;
        }
        _task.LaunchJson = TaskFlow.Write(_task.LaunchJson, _flow);
        _task.ExecutorIds = _executorId is null ? [] : [_executorId];
        // могут заменить исполнителя (T-221): основного из списка выбрасываем — он мог
        // попасть туда до того, как его же назначили исполнителем
        _task.AltExecutorIds = _altExecutorIds.Where(id => id != _executorId).ToList();
        // суфлёр задачи (T-292-S0): основным исполнителем он быть не может — пока тот
        // считает генерацию, он занят, и ждать пришлось бы самого себя
        _task.PrompterExecutorId = _prompterExecutorId == _executorId ? null : _prompterExecutorId;
        _task.PrompterAltExecutorIds = _prompterAltExecutorIds
            .Where(id => id != _executorId && id != _task.PrompterExecutorId).ToList();
        _task.SkillIds = _skillIds.ToList();
        _task.BlockerIds = _blockerIds.ToList();
        // ссылка импорта (T-246): пустое поле — намерение очистить, поэтому уходит null,
        // а не пустая строка; хранилище приводит значение тем же способом
        _task.ImportUrl = _importUrl?.Trim() is { Length: > 0 } importUrl ? importUrl : null;
        // тэги (T-222): недобавленное содержимое поля ввода не теряется — человек написал
        // тэг и нажал «Сохранить», не нажав «+», и это ровно то же намерение
        _task.Tags = TaskTags.Normalize(_tags.Concat([_newTag]));
        // «время ↔ качество» (T-23-S0) уходит числом: в форме показано ровно то, с чем пойдёт
        // работа, и сохранение делает это явным выбором человека — дальше правка умолчания
        // проекта эту задачу уже не двигает
        _task.TimeQuality = _timeQuality;
        Dialog.Close(DialogResult.Ok(new TaskSaveDto
        {
            Task = _task,
            Description = _description,
            Acceptance = _acceptance,
        }));
    }
}
