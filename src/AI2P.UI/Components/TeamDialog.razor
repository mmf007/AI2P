@inject UiState State
@inject I18nService L

@* Форма ввода команды (ТЗ гл. 11): название + оргструктура (T-628-S0). Состав команды —
   дерево оргединиц: подразделение или должность, наименование, исполнитель (у подразделения —
   руководитель, у должности может быть пуст — вакансия), навыки единицы. Подчинение участников
   («руководитель» ТЗ v1.17) сервер выводит из дерева: руководитель — исполнитель ближайшей
   вышестоящей единицы с исполнителем. Тимлид — только участник верхнего уровня; единственный
   участник верхнего уровня становится тимлидом автоматически. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_team.Name" Label="@L["teams.name"]" Immediate="true"
                          Error="@NameTaken" ErrorText="@L["teams.nameTaken"]" />
            <MudTextField @bind-Value="_team.AgentLanguage" Label="@L["teams.agentLanguage"]" />
            <MudSwitch T="bool" @bind-Value="_team.IsActive" Label="@L["common.active"]" Color="Color.Primary" />

            @* оргструктура таблицей-деревом; перенос по иерархии — выбором «Входит в» *@
            <MudText Typo="Typo.subtitle2">@L["teams.units"]</MudText>
            <MudText Typo="Typo.caption">@L["teams.unitsHint"]</MudText>
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th style="min-width: 160px;">@L["teams.unitKind"]</th>
                        <th style="min-width: 190px;">@L["teams.unitName"]</th>
                        <th style="min-width: 180px;">@L["teams.unitExecutor"]</th>
                        <th style="min-width: 170px;">@L["teams.unitParent"]</th>
                        <th style="min-width: 180px;">@L["teams.unitSkills"]</th>
                        <th style="min-width: 150px;">@L["teams.role"]</th>
                        <th>@L["teams.lead"]</th>
                        <th>@L["teams.memberActive"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (unit, depth) in Ordered())
                    {
                        var member = MemberOf(unit);
                        <tr data-team-unit="@unit.Id">
                            <td>
                                <div style="@($"padding-left: {depth * 20}px;")">
                                    <MudSelect T="string" @bind-Value="unit.Kind" Dense="true" Margin="Margin.Dense">
                                        <MudSelectItem T="string" Value="@TeamUnit.Department">@L["teams.unitKind.department"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@TeamUnit.Position">@L["teams.unitKind.position"]</MudSelectItem>
                                    </MudSelect>
                                </div>
                            </td>
                            <td>
                                <MudTextField T="string" @bind-Value="unit.Name" Margin="Margin.Dense" />
                            </td>
                            <td>
                                @* только активные исполнители (ТЗ п. 2.2), не занявшие другую единицу;
                                   пусто — вакансия (у подразделения — без руководителя) *@
                                <MudSelect T="string" Value="@unit.ExecutorId"
                                           ValueChanged="@(value => OnExecutorChanged(unit, value))"
                                           Dense="true" Margin="Margin.Dense" Clearable="true"
                                           Placeholder="@L["teams.vacancy"]">
                                    @foreach (var executor in AvailableFor(unit))
                                    {
                                        <MudSelectItem T="string" Value="@executor.Id">@executor.Nick</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td>
                                @* вышестоящая единица: себя и своё поддерево выбрать нельзя — цикла не бывает *@
                                <MudSelect T="string" @bind-Value="unit.ParentUnitId"
                                           Dense="true" Margin="Margin.Dense" Clearable="true"
                                           Placeholder="@L["teams.topLevel"]">
                                    @foreach (var other in _team.Units.Where(u => !IsInside(u, unit)))
                                    {
                                        <MudSelectItem T="string" Value="@other.Id">@UnitTitle(other)</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td>
                                @* навыки единицы добавляются к навыкам занявшего её исполнителя
                                   при автоподборе в этой команде *@
                                <MudSelect T="string" MultiSelection="true" Dense="true" Margin="Margin.Dense"
                                           SelectedValues="@unit.SkillIds"
                                           SelectedValuesChanged="@(values => unit.SkillIds = values.ToList())"
                                           ToStringFunc="@SkillTitle">
                                    @foreach (var skill in State.Skills)
                                    {
                                        <MudSelectItem T="string" Value="@skill.Id">@skill.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            @if (member is not null)
                            {
                                <td>
                                    <MudSelect T="string" @bind-Value="member.RoleId" Dense="true"
                                               Margin="Margin.Dense" Clearable="true">
                                        @foreach (var role in State.Roles)
                                        {
                                            <MudSelectItem T="string" Value="@role.Id">@role.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    @* тимлид: доступен только участнику верхнего уровня (ТЗ v1.17) *@
                                    <MudTooltip Text="@L["teams.leadHint"]">
                                        <MudCheckBox T="bool" Value="@member.IsLead"
                                                     ValueChanged="@(value => OnLeadChanged(member, value))"
                                                     Dense="true" Disabled="@(Head(unit) is not null)" />
                                    </MudTooltip>
                                </td>
                                <td>
                                    @* активность участника В ЭТОЙ КОМАНДЕ (T-129): неактивный не
                                       подключается при запуске команды и не берётся автоподбором *@
                                    <MudTooltip Text="@L["teams.memberActiveHint"]">
                                        <MudCheckBox T="bool" @bind-Value="member.IsActive" Dense="true" />
                                    </MudTooltip>
                                </td>
                            }
                            else
                            {
                                <td></td>
                                <td></td>
                                <td></td>
                            }
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               OnClick="@(() => RemoveUnit(unit))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <div>
                <MudButton StartIcon="@Icons.Material.Filled.CreateNewFolder"
                           OnClick="@(() => AddUnit(TeamUnit.Department))">@L["teams.addDepartment"]</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="@(() => AddUnit(TeamUnit.Position))">@L["teams.addPosition"]</MudButton>
            </div>
            @if (HierarchyError is { } error)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_team.Name.Trim().Length == 0 || NameTaken || HierarchyError is not null)"
                   OnClick="Save">@L["common.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>null — создание новой команды.</summary>
    [Parameter] public Team? Source { get; set; }

    private Team _team = new();

    /// <summary>Имя команды уникально (ТЗ гл. 11, правка v1.13).</summary>
    private bool NameTaken => State.Teams.Any(t =>
        t.Id != _team.Id &&
        t.Name.Trim().Equals(_team.Name.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Проверка на клиенте: один исполнитель — одна единица; сервер проверяет ещё раз.
    /// Ошибка блокирует сохранение — падать нельзя (исключение в рендере убивает Blazor-circuit,
    /// багфикс v1.18). Циклов не бывает: «Входит в» не предлагает своё поддерево.</summary>
    private string? HierarchyError =>
        _team.Units.Where(u => u.ExecutorId is not null).GroupBy(u => u.ExecutorId).Any(g => g.Count() > 1)
            ? L["teams.duplicateMember"]
            : null;

    private string Nick(string executorId) =>
        State.Executors.FirstOrDefault(e => e.Id == executorId)?.Nick ?? executorId;

    private string UnitTitle(TeamUnit unit)
    {
        var name = unit.Name.Trim().Length > 0 ? unit.Name.Trim() : L["teams.unitKind." + unit.Kind];
        return unit.ExecutorId is { } e ? $"{name} ({Nick(e)})" : name;
    }

    private string SkillTitle(string? skillId) =>
        State.Skills.FirstOrDefault(s => s.Id == skillId)?.Name ?? skillId ?? "";

    private TeamUnit? Find(string? id) => id is null ? null : _team.Units.FirstOrDefault(u => u.Id == id);

    /// <summary>Лежит ли <paramref name="unit"/> внутри <paramref name="ancestor"/> (или совпадает).</summary>
    private bool IsInside(TeamUnit unit, TeamUnit ancestor)
    {
        var seen = new HashSet<string>();
        for (var up = unit; up is not null && seen.Add(up.Id); up = Find(up.ParentUnitId))
        {
            if (up == ancestor)
            {
                return true;
            }
        }
        return false;
    }

    /// <summary>Руководитель единицы — исполнитель ближайшей вышестоящей единицы с исполнителем.</summary>
    private string? Head(TeamUnit unit)
    {
        var seen = new HashSet<string> { unit.Id };
        for (var up = Find(unit.ParentUnitId); up is not null && seen.Add(up.Id); up = Find(up.ParentUnitId))
        {
            if (up.ExecutorId is not null)
            {
                return up.ExecutorId;
            }
        }
        return null;
    }

    /// <summary>Единицы деревом: обход в глубину с уровнем вложенности.</summary>
    private List<(TeamUnit Unit, int Depth)> Ordered()
    {
        var result = new List<(TeamUnit, int)>();
        var seen = new HashSet<string>();
        void Walk(TeamUnit? parent, int depth)
        {
            var children = _team.Units
                .Where(u => parent is null ? Find(u.ParentUnitId) is null : u.ParentUnitId == parent.Id)
                .OrderBy(u => u.Sort)
                .ToList();
            foreach (var unit in children)
            {
                if (seen.Add(unit.Id))
                {
                    result.Add((unit, depth));
                    Walk(unit, depth + 1);
                }
            }
        }
        Walk(null, 0);
        return result;
    }

    private TeamMember? MemberOf(TeamUnit unit) =>
        unit.ExecutorId is null ? null : _team.Members.FirstOrDefault(m => m.ExecutorId == unit.ExecutorId);

    protected override void OnInitialized()
    {
        if (Source is not null)
        {
            // редактируем копию, чтобы отмена не портила кэш состояния
            _team = new Team
            {
                Id = Source.Id,
                DisplayId = Source.DisplayId,
                Name = Source.Name,
                ProjectId = Source.ProjectId,
                AgentLanguage = Source.AgentLanguage,
                IsActive = Source.IsActive,
                Members = Source.Members
                    .Select(m => new TeamMember
                    {
                        ExecutorId = m.ExecutorId,
                        RoleId = m.RoleId,
                        ParentExecutorId = m.ParentExecutorId,
                        IsLead = m.IsLead,
                        IsActive = m.IsActive,
                    })
                    .ToList(),
                Units = Source.Units
                    .Select(u => new TeamUnit
                    {
                        Id = u.Id,
                        ParentUnitId = u.ParentUnitId,
                        Kind = u.Kind,
                        Name = u.Name,
                        ExecutorId = u.ExecutorId,
                        Sort = u.Sort,
                        IsActive = u.IsActive,
                        SkillIds = u.SkillIds.ToList(),
                    })
                    .ToList(),
            };
        }
    }

    /// <summary>Исполнители, доступные единице: активные, не занявшие другую единицу
    /// (+ текущее значение, чтобы выбор не пропадал). Дубликаты запрещены (v1.18).</summary>
    private IEnumerable<Executor> AvailableFor(TeamUnit unit) =>
        State.Executors.Where(e =>
            e.Id == unit.ExecutorId
            || (e.IsActive && _team.Units.All(u => u == unit || u.ExecutorId != e.Id)));

    private void AddUnit(string kind) =>
        _team.Units.Add(new TeamUnit
        {
            Kind = kind,
            Sort = _team.Units.Count == 0 ? 0 : _team.Units.Max(u => u.Sort) + 1,
        });

    private void OnExecutorChanged(TeamUnit unit, string? executorId)
    {
        unit.ExecutorId = executorId is { Length: > 0 } ? executorId : null;
        if (unit.ExecutorId is { } e && _team.Members.All(m => m.ExecutorId != e))
        {
            _team.Members.Add(new TeamMember { ExecutorId = e });
        }
        SyncMembers();
    }

    private void RemoveUnit(TeamUnit unit)
    {
        _team.Units.Remove(unit);
        // вложенные единицы поднимаются на уровень удалённой
        foreach (var child in _team.Units.Where(u => u.ParentUnitId == unit.Id))
        {
            child.ParentUnitId = unit.ParentUnitId;
        }
        SyncMembers();
    }

    /// <summary>Состав команды — исполнители единиц: ушедший с единицы выбывает из состава.</summary>
    private void SyncMembers() =>
        _team.Members.RemoveAll(m => _team.Units.All(u => u.ExecutorId != m.ExecutorId));

    private void OnLeadChanged(TeamMember member, bool value)
    {
        member.IsLead = value;
        if (value)
        {
            // тимлид один: у остальных признак снимается (ТЗ v1.17)
            foreach (var other in _team.Members.Where(m => m != member))
            {
                other.IsLead = false;
            }
        }
    }

    private void Save()
    {
        SyncMembers();
        var order = Ordered();
        for (var i = 0; i < order.Count; i++)
        {
            order[i].Unit.Sort = i;
        }
        Dialog.Close(DialogResult.Ok(_team));
    }
}
