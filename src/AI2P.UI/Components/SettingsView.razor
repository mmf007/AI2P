    private async Task EditModelAsync(AiModel? model)
    {
        var parameters = new DialogParameters<AiModelDialog>
        {
            { d => d.Source, model },
            // состояние установки (ТЗ v1.41): блокирует «активна» у неустановленной
            { d => d.Install, model is not null && _installs.TryGetValue(model.Id, out var inst) ? inst : null },
        };
        var dialog = await Dialogs.ShowAsync<AiModelDialog>(
            model is null ? L["models.add"] : L["common.edit"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        // установка и ключ меняют состояние модели прямо из формы (ТЗ v1.42) — обновляем
        // справочник и состояния установки в любом случае, даже при отмене формы
        await LoadInstallsAsync();
        if (result is { Canceled: false, Data: AiModel edited })
        {
            try
            {
                if (model is null)
                {
                    await Api.CreateModelAsync(edited);
                }
                else
                {
                    await Api.UpdateModelAsync(edited);
                }
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        await State.RefreshReferenceDataAsync();
        State.NotifyChanged();
    }

    // --- почта уведомлений (T-272) ---

    /// <summary>Новый пароль SMTP. Пустое поле означает «не менять»: пароль хранится в
    /// секретах и наружу не отдаётся, поэтому предзаполнить поле нечем — а без этого
    /// правила каждое сохранение настроек стирало бы пароль.</summary>
    private string _mailPassword = "";

    private string MailPasswordHint => _settings?.Mail is { } mail
        ? (mail.HasPassword ? L["mail.password.set"] : L["mail.password.unset"])
          + " · " + mail.PasswordFile
        : "";

    /// <summary>Пробное письмо на свой адрес: проверить настройки, не дожидаясь события.</summary>
    private async Task MailTestAsync()
    {
        try
        {
            var result = await Api.SendNotificationTestAsync("");
            Snackbar.Add($"{L["mail.test.done"]}: {result.Address}", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Карандаш вкладки «основное» (T-123-S0): запомнить значения и включить правку.</summary>
    private void StartEditMain()
    {
        if (_settings is not { } s)
        {
            return;
        }
        _mainBackup = (s.Language, s.OpenBrowserOnStart, s.TabTitleMode, s.ScheduleCellMode,
            s.LogLevel, s.LoraImage.MaxWidth, s.LoraImage.MaxHeight, s.LoraImage.MaxKb,
            s.LoraImage.Format, s.LoraImage.PadColor);
        _updateBackup = (s.Update.AutoCheck, s.Update.AutoUpdate, s.Update.Time, s.Update.Url);
        _editingMain = true;
    }

    /// <summary>«Отменить» на вкладке «основное» (T-123-S0): вернуть запомненное и выйти из правки.</summary>
    private void CancelMain()
    {
        if (_settings is { } s && _mainBackup is { } b)
        {
            s.Language = b.Language;
            s.OpenBrowserOnStart = b.OpenBrowser;
            s.TabTitleMode = b.TabTitle;
            s.ScheduleCellMode = b.ScheduleCell;
            s.LogLevel = b.LogLevel;
            s.LoraImage.MaxWidth = b.MaxWidth;
            s.LoraImage.MaxHeight = b.MaxHeight;
            s.LoraImage.MaxKb = b.MaxKb;
            s.LoraImage.Format = b.Format;
            s.LoraImage.PadColor = b.PadColor;
        }
        // автообновление (T-208) запоминается отдельным снимком: у него свои четыре поля,
        // и дописывать их в общий кортеж значило бы править десять строк ради двух флажков
        if (_settings is { } cur && _updateBackup is { } up)
        {
            cur.Update.AutoCheck = up.AutoCheck;
            cur.Update.AutoUpdate = up.AutoUpdate;
            cur.Update.Time = up.Time;
            cur.Update.Url = up.Url;
        }
        _mainBackup = null;
        _updateBackup = null;
        _editingMain = false;
    }

    /// <summary>«Сохранить» на вкладке «основное»: после УДАЧНОЙ записи — обратно в режим
    /// чтения. Отказ сервера правку не заканчивает: набранное осталось бы негде взять.</summary>
    private async Task SaveMainAsync()
    {
        if (await SaveAsync())
        {
            _mainBackup = null;
            _updateBackup = null;
            _editingMain = false;
            // флажки автообновления заводят и удаляют записи расписания (T-208) — их коды
            // приходят с сервера, поэтому после записи настройки перечитываются
            _settings = await Api.GetSettingsAsync();
        }
    }

    /// <summary>
    /// «Проверить обновления» (T-208): один поход в репозиторий выпусков. Отказ сети —
    /// это ПОЛЕ ОТВЕТА, а не исключение: строка под кнопкой, а не красная плашка.
    /// </summary>
    private async Task CheckUpdateAsync()
    {
        _updateBusy = true;
        _updateAgents = [];
        try
        {
            _update = await Api.CheckUpdateAsync();
        }
        finally
        {
            _updateBusy = false;
        }
    }

    /// <summary>
    /// «Обновить» (T-208): сначала спрашиваем, кого остановит перезапуск, показываем
    /// список и переспрашиваем — и только потом качаем пакет. Сервер после ответа
    /// заканчивает работу сам, поэтому последнее, что успевает сделать страница, —
    /// сказать человеку, что произошло.
    /// </summary>
    private async Task RunUpdateAsync()
    {
        if (_update is not { Available: true })
        {
            return;
        }
        _updateBusy = true;
        try
        {
            _updateAgents = (await Api.UpdateAgentsAsync()).Agents;
            _updateMessage = _updateAgents.Count > 0
                ? L["settings.update.agents"] + " " + string.Join("; ", _updateAgents)
                : L["settings.update.found", _update.Version];
            var yes = await _updateBox.ShowAsync();
            if (yes != true)
            {
                return;
            }
            var started = await Api.RunUpdateAsync();
            Snackbar.Add(L["settings.update.started", started.Version], Severity.Info);
        }
        finally
        {
            _updateBusy = false;
        }
    }

    /// <summary>Запись настроек. Возвращает «удалось» — по нему вкладка «основное»
    /// решает, выходить ли из режима редактирования (T-123-S0).</summary>
    private async Task<bool> SaveAsync()
    {
        if (_settings is null)
        {
            return false;
        }
        try
        {
            // пароль SMTP уходит, только если его ввели: null — «не менять» (T-272)
            _settings.Mail.Password = _mailPassword.Length > 0 ? _mailPassword : null;
            await Api.SaveSettingsAsync(_settings);
            if (_mailPassword.Length > 0)
            {
                _settings.Mail.HasPassword = true;
                _mailPassword = "";
            }
            _settings.Mail.Password = null;
            L.Lang = _settings.Language; // смена языка «на лету» (гл. 9)
            State.SetTabTitleMode(_settings.TabTitleMode); // заголовки закладок «на лету» (v1.18)
            State.SetScheduleCellMode(_settings.ScheduleCellMode); // ячейка календаря «на лету» (v1.37)
            await LoadActionsAsync(); // тексты действий — в новом языке (todo24)
            await LoadStatusesAsync(); // названия состояний — в новом языке (v1.37)
            await State.RefreshTaskStatusesAsync(L.Lang);
            Snackbar.Add(L["settings.saved"], Severity.Success);
            return true;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
    }
}
