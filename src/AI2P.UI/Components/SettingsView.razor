    /// <summary>Форма состояния (todo34_3): у встроенных код не меняется, признак «кастом» —
    /// только в debug-режиме; после сохранения справочник в UiState обновляется.</summary>
    private async Task EditStatusAsync(TaskStatusDef? status)
    {
        var parameters = new DialogParameters<TaskStatusDialog>
        {
            { d => d.Source, status },
            { d => d.TakenIds, _statuses.Where(s => s.Id != status?.Id).Select(s => s.Id).ToList() },
        };
        var dialog = await Dialogs.ShowAsync<TaskStatusDialog>(
            status is null ? L["statuses.add"] : L["common.edit"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TaskStatusSaveDto dto })
        {
            try
            {
                if (status is null)
                {
                    await Api.CreateTaskStatusAsync(dto, L.Lang);
                }
                else
                {
                    await Api.UpdateTaskStatusAsync(status.Id, dto, L.Lang);
                }
                await LoadStatusesAsync();
                await State.RefreshTaskStatusesAsync(L.Lang); // доска/списки видят правки сразу
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

