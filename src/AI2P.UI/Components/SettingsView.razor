    // --- организации (ТЗ п. 2.15, этап 40) ---
    private async Task LoadOrgsAsync()
    {
        // условие то же, что у вкладки (T-201-S0): хозяин компьютера, а не владелец
        // открытой сейчас организации
        if (!State.CanManageOrgs)
        {
            return;
        }
        try
        {
            _orgs = await Api.GetOrgsAsync();
            // переключатель организаций в тулбаре держит свой список, полученный при старте
            // (T-148-S0): без этого только что созданная организация не появлялась в форме
            // смены до перезагрузки страницы
            State.SetOrgs(_orgs);
            _orgServers = [];
            foreach (var org in _orgs)
            {
                _orgServers[org.Id] = await Api.GetOrgServersAsync(org.Id);
            }
            // архивы — дочерний список записи ОТКРЫТОЙ организации (T-43-S0)
            await LoadArchivesAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // --- АРХИВЫ ОРГАНИЗАЦИИ (T-43-S0, выпуск 1.105) ---
    // Дочерний список записи организации. Реестр архивов общий на кластер, а состояние
    // (открыт / закрыт / удалён) у каждого сервера своё, поэтому список приходит с состоянием
    // ЭТОГО сервера, и открыть / закрыть / удалить действуют тоже только здесь.

    private List<Archive> _archives = [];

    /// <summary>Это ОТКРЫТАЯ сейчас организация: архивы читаются в её контексте, у чужих
    /// организаций спросить их этому серверу нечем.</summary>
    private bool IsCurrentOrg(Organization org) => org.Id == State.Org.Id;

    /// <summary>Состояние архива для колонки «активен»: текущий — свойство самого архива
    /// (одно на кластер), остальные три — его состояние на этом сервере.</summary>
    private static string ArchiveStateCode(Archive archive) =>
        archive.IsCurrent ? "current" : archive.State;

