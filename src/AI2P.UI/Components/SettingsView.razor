    /// <summary>
    /// Удалить пользователя (T-140): переспрос, затем удаление. Аккаунт помечается удалённым —
    /// войти под ним нельзя, из списка он уходит, а сделанное им в журнале работ остаётся.
    /// </summary>
    private async Task DeleteAccountAsync(Account account)
    {
        if (await _accountDeleteBox.ShowAsync() != true)
        {
            return;
        }
        try
        {
            await Api.DeleteAccountAsync(account.Id);
            await LoadAccountsAsync();
            // исполнитель организации остаётся (он актор действий в журнале), но список
            // людей мог измениться — перечитываем справочники, как и при заведении
            await State.RefreshReferenceDataAsync();
            State.NotifyChanged();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

