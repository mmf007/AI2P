    {
        if (!State.CanAdmin || State.NoOrg)
        {
            return;
        }
        try
        {
            _archives = await Api.GetArchivesAsync();
            // ПОЛЕ «СРЕДА» В ТУЛБАРЕ (T-200-S0): у него свой список открытых архивов,
            // и читался он только при входе. Отдаём ему уже прочитанный список —
            // добавленный архив появляется сразу, закрытый сразу исчезает
            await State.ApplyArchivesAsync(_archives);
