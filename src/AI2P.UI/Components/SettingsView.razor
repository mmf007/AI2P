    /// <summary>Раскрыть/закрыть категорию навыка.</summary>
    private void ToggleSkill(string skill)
    {
        if (!_openSkills.Remove(skill))
        {
            _openSkills.Add(skill);
        }
    }

    /// <summary>Заголовок категории: «код — описание навыка» из справочника (описание
    /// встроенного навыка переводится, как в списке навыков), пустой код — «без навыков».</summary>
    private string SkillCategoryTitle(string skill)
    {
        if (skill.Length == 0)
        {
            return L["models.skills.none"];
        }
        var known = State.Skills.FirstOrDefault(s => string.Equals(s.Name, skill, StringComparison.OrdinalIgnoreCase));
        if (known is null)
        {
            return skill;   // навык объявлен в декларации, но из справочника уже убран
        }
        var text = known.IsCustom ? known.Description : Localized("skill." + known.Name, known.Description);
        return text.Length > 0 ? $"{skill} — {text}" : skill;
    }

