    private string ArchiveServersText(Archive archive) =>
        string.Join(", ", archive.Servers.Select(id =>
        {
            var code = State.ServerCodeOf(id);
            return (code.Length > 0 ? code : id) + (id == State.ServerId ? " ✓" : "");
        }));

