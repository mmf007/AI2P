    /// <summary>
    /// Пользователя можно удалить (T-140): он НЕАКТИВЕН, он не владелец системы и он не вы сами.
    /// Роль здесь — роль в ТЕКУЩЕЙ организации; окончательное решение всё равно за сервером,
    /// он смотрит все организации сразу и на отказ отвечает понятным текстом.
    /// </summary>
    private bool CanDeleteAccount(Account account) =>
        !account.IsActive && account.Role != SystemRole.Owner && account.Id != State.Account.Id;

