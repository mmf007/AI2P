    /// </summary>
    private async Task EditServerAsync(ServerNode? server)
    {
        if (server is { IsLocal: true })
        {
            var local = await Dialogs.ShowAsync<LocalServerDialog>(L["servers.local.title"],
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            await local.Result;
            await LoadServersAsync();
            return;
        }
        var parameters = new DialogParameters<ServerDialog>
        {
            { d => d.Source, server },
            { d => d.Orgs, _orgs },
            // интервалы репликации чужого сервера задаёт дирижёр (ТЗ гл. 6, этап 43)
            { d => d.IsLocalConductor, State.IsConductor },
            // времена пары лежат в записи её рядового конца — на рядовом сервере это мы сами
            // (T-50-S0), поэтому форме нужна и наша запись
            { d => d.Local, _servers.FirstOrDefault(s => s.IsLocal) },
        };
        var dialog = await Dialogs.ShowAsync<ServerDialog>(
            server is null ? L["servers.add"] : L["common.edit"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ServerSaveDto dto })
        {
            try
            {
                if (server is null)
                {
                    await Api.CreateServerAsync(dto);
                }
                else
                {
                    await Api.UpdateServerAsync(server.Id, dto);
                }
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        await LoadServersAsync();
        await LoadOrgsAsync();
    }

