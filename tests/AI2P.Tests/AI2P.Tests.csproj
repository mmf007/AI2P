<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AI2P.Core\AI2P.Core.csproj" />
    <ProjectReference Include="..\..\src\AI2P.Storage\AI2P.Storage.csproj" />
    <ProjectReference Include="..\..\src\AI2P.Connectors\AI2P.Connectors.csproj" />
    <!-- раунд-трип MD-редактора: Md (Markdig) → MdHtml (todo30_2) -->
    <ProjectReference Include="..\..\src\AI2P.UI\AI2P.UI.csproj" />
    <!-- доверие внутренним вызовам UI и вход администратора сервера (гл. 12, todo41) -->
    <ProjectReference Include="..\..\src\AI2P.Server\AI2P.Server.csproj" />
  </ItemGroup>

  <!-- файлы сида справочника действий (todo24) и словари языков (ТЗ гл. 9, T-180): тесты
       работают с теми же файлами дистрибутива — тексты сообщений хранилища, коннекторов и
       API лежат в словарях, и без них проверять было бы нечего -->
  <ItemGroup>
    <Content Include="..\..\i18n\*.json" Link="i18n\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
